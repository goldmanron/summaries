\begin_layout Proof
נגדיר פרדיקט 
\begin_inset Formula $\reach\left(u,v,t\right)$
\end_inset

 —
 יש מסלול מ-
\begin_inset Formula $u$
\end_inset

 ל-
\begin_inset Formula $v$
\end_inset

 באורך לכל היותר 
\begin_inset Formula $2^{t}$
\end_inset

.
 המטרה היא לכתוב את 
\begin_inset Formula $\reach\left(c_{0},c_{acc},m\right)$
\end_inset

 כנוסחת 
\begin_inset Formula $\qbf$
\end_inset

 בגודל פולינומי.
\end_layout

\begin_layout Proof

\series bold
ניסיון ראשון:
\series default

\begin_inset Formula 
\[
\reach\left(u,v,t\right)=\exists w\ \reach\left(u,w,t-1\right)\land\reach\left(w,v,t-1\right).
\]

\end_inset

הבעיה:
 כל רמה מכפילה את גודל הנוסחה,
 ולכן הגודל הוא 
\begin_inset Formula $2^{m}$
\end_inset

,
 אקספוננציאלי (הגרף עצמו בגודל אקספוננציאלי).
\end_layout

\begin_layout Proof

\series bold
ניסיון שני:

\series default
 במקום שני עותקים של 
\begin_inset Formula $\reach\left(\cdot,\cdot,t-1\right)$
\end_inset

 נשתמש בעותק אחד,
 וביט 
\begin_inset Formula $\sigma$
\end_inset

 יבחר איזה חצי של המסלול בודקים:
\begin_inset Formula 
\[
\reach\left(u,v,t\right)=\exists w\ \forall\sigma\ \exists a,b\ \left[\left(\sigma=0\rightarrow\left(a=u\land b=w\right)\right)\land\left(\sigma=1\rightarrow\left(a=w\land b=v\right)\right)\land\reach\left(a,b,t-1\right)\right].
\]

\end_inset

כאן 
\begin_inset Formula $w,a,b$
\end_inset

 הן קונפיגורציות,
 כלומר בלוקים של 
\begin_inset Formula $O\left(s\right)$
\end_inset

 משתנים בוליאניים,
 ו-
\begin_inset Formula $\sigma$
\end_inset

 הוא ביט.
 כשוויון 
\begin_inset Formula $\sigma=0$
\end_inset

 הנוסחה מחייבת 
\begin_inset Formula $\reach\left(u,w,t-1\right)$
\end_inset

,
 וכש-
\begin_inset Formula $\sigma=1$
\end_inset

 היא מחייבת 
\begin_inset Formula $\reach\left(w,v,t-1\right)$
\end_inset

.
 שוויון קונפיגורציות הוא נוסחה בגודל 
\begin_inset Formula $O\left(s\right)$
\end_inset

,
 ולכן עבור הגודל 
\begin_inset Formula $L\left(t\right)$
\end_inset


\begin_inset Formula 
\[
L\left(t\right)=L\left(t-1\right)+O\left(s\right)\implies L\left(m\right)=O\left(s\cdot m\right)+L\left(0\right)=\poly\left(n\right).
\]

\end_inset


\end_layout

\begin_layout Proof
כיוון שכל רמה משתמשת במשתנים חדשים,
 אפשר להוציא את כל הכמתים החוצה,
 והנוסחה הסופית היא 
\begin_inset Formula 
\begin{align*}
\varphi_{x}=\  & \exists w_{1}\forall\sigma_{1}\exists a_{1},b_{1}\ \cdots\ \exists w_{m}\forall\sigma_{m}\exists a_{m},b_{m}\\
 & \bigwedge^{m}_{i=1}\left[\left(\sigma_{i}=0\rightarrow\left(a_{i}=a_{i-1}\land b_{i}=w_{i}\right)\right)\land\left(\sigma_{i}=1\rightarrow\left(a_{i}=w_{i}\land b_{i}=b_{i-1}\right)\right)\right]\land\reach\left(a_{m},b_{m},0\right),
\end{align*}

\end_inset

כאשר 
\begin_inset Formula $a_{0}=c_{0}$
\end_inset

 ו-
\begin_inset Formula $b_{0}=c_{acc}$
\end_inset

.
\end_layout

