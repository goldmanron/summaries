\end_inset

 ובזמן 
\begin_inset Formula $t_{1}$
\end_inset

,
 ו-
\begin_inset Formula $f_{2}$
\end_inset

 ניתנת לחישוב בזכרון 
\begin_inset Formula $s_{2}$
\end_inset

 ובזמן 
\begin_inset Formula $t_{2}$
\end_inset

.
 נרצה לחשב את 
\begin_inset Formula $f_{1}\left(f_{2}\left(x\right)\right)$
\end_inset

.
\end_layout

\begin_layout Enumerate

\series bold
שיטה ראשונה:

\series default
 נחשב את 
\begin_inset Formula $f_{2}\left(x\right)$
\end_inset

,
 נכתוב אותו על סרט העבודה,
 ואז נריץ את המכונה של 
\begin_inset Formula $f_{1}$
\end_inset

 עליו.
\begin_inset Newline newline
\end_inset

זכרון:
 
\begin_inset Formula $O\left(s_{2}\left(\left|x\right|\right)+\left|f_{2}\left(x\right)\right|+s_{1}\left(\left|f_{2}\left(x\right)\right|\right)\right)$
\end_inset


\begin_inset Newline newline
\end_inset

זמן:
 
\begin_inset Formula $t_{2}\left(\left|x\right|\right)+t_{1}\left(\left|f_{2}\left(x\right)\right|\right)$
\end_inset


\end_layout

\begin_layout Enumerate

\series bold
שיטה שנייה:

\series default
 נריץ את המכונה של 
\begin_inset Formula $f_{1}$
\end_inset

 כאילו 
\begin_inset Formula $f_{2}\left(x\right)$
\end_inset

 כתוב על סרט הקלט שלה.
 בכל פעם שהיא צריכה לקרוא את הביט ה-
\begin_inset Formula $i$
\end_inset

 של 
\begin_inset Formula $f_{2}\left(x\right)$
\end_inset

,
 נריץ מחדש (בחלק נפרד של סרט העבודה) את החישוב של 
\begin_inset Formula $f_{2}\left(x\right)$
\end_inset

,
 נספור את ביטי הפלט עד שנגיע לביט ה-
\begin_inset Formula $i$
\end_inset

 ונחזיר אותו.
\begin_inset Newline newline
\end_inset

זכרון:
 
\begin_inset Formula $O\left(s_{1}\left(\left|f_{2}\left(x\right)\right|\right)+\log\left|f_{2}\left(x\right)\right|+s_{2}\left(\left|x\right|\right)\right)$
\end_inset


\begin_inset Newline newline
\end_inset

זמן:
 
\begin_inset Formula $O\left(t_{1}\left(\left|f_{2}\left(x\right)\right|\right)\cdot t_{2}\left(\left|x\right|\right)\right)$
\end_inset


\end_layout

\begin_layout Standard
כלומר בשיטה השנייה במקום לשמור את כל 
\begin_inset Formula $f_{2}\left(x\right)$
\end_inset

 שומרים רק את האינדקס של הביט הנקרא,
 אבל זמן הריצה מוכפל במקום להתחבר.
\end_layout

\begin_layout Corollary
אם 
\begin_inset Formula $s_{1},s_{2}=O\left(\log n\right)$
\end_inset

 אזי ניתן לחשב את 
\begin_inset Formula $f_{1}\circ f_{2}$
\end_inset

 בזכרון 
\begin_inset Formula $O\left(\log n\right)$
\end_inset

.
