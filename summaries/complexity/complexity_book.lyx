\begin_layout Theorem
\begin_inset Argument 1
status open

\begin_layout Plain Layout
שאנון
\end_layout

\end_inset

 תהא 
\begin_inset Formula $F_{n}\subseteq\left\{ 0,1\right\} ^{n}\rightarrow\left\{ 0,1\right\} $
\end_inset

 קבוצת הפונקציות שחשיבות על ידי מעגל בגודל 
\begin_inset Formula $o\left(\frac{2^{n}}{n}\right)$
\end_inset

.
 אזי 
\begin_inset Formula $\frac{\left|F_{n}\right|}{2^{2^{n}}}=2^{-\Omega\left(n\right)}$
\end_inset

.
\end_layout

\begin_layout Theorem
מנגד,
 כל פונ' 
\begin_inset Formula $f:\left\{ 0,1\right\} ^{n}\rightarrow\left\{ 0,1\right\} $
\end_inset

 ניתנת לחישוב ע
\begin_inset Quotes erd
\end_inset

י מעגל בגודל 
\begin_inset Formula $O\left(\frac{2^{n}}{n}\right)$
\end_inset

.
\end_layout

\begin_layout Section
משפט ההיררכייה למעגלים
\end_layout

\begin_layout Theorem
קיים קבוע 
\begin_inset Formula $c>0$
\end_inset

 כך שלכל 
\begin_inset Formula $1\leq s\leq\frac{2^{n}}{cn}$
\end_inset

 יש פונ' 
\begin_inset Formula $f:\left\{ 0,1\right\} ^{n}\rightarrow\left\{ 0,1\right\} $
\end_inset

 כך ש–
\begin_inset Formula 
\[
s<\sz f\leq s+2n.
\]

\end_inset


\end_layout

\begin_deeper
\begin_layout Proof
תהא 
\begin_inset Formula $F:\left\{ 0,1\right\} ^{n}\rightarrow\left\{ 0,1\right\} $
\end_inset

 פונ' כך ש-
\begin_inset Formula $\sz F\geq\frac{2^{n}}{cn}$
\end_inset

.
\end_layout

\begin_layout Proof
נגדיר את סדרת הפונ' הבאה:
\begin_inset Formula 
\begin{align*}
F_{n} & \equiv0\\
F_{2^{n}} & \equiv F\\
F_{k}\left(x\right) & =\begin{cases}
F\left(x\right), & 1+\sum^{n-1}_{i=1}x_{i}2^{i-1}\leq k\\
0, & else
\end{cases}
\end{align*}

\end_inset

מתקיים כי 
\begin_inset Formula $\sz{F_{0}}=1,\sz{F_{2^{n}}}\geq\frac{2^{n}}{cn}$
\end_inset

,
 מתקיים כי לכל 
\begin_inset Formula $k$
\end_inset

,
\begin_inset Formula 
\[
\sz{F_{k+1}}-\sz{F_{k}}\leq2n,
\]

\end_inset

משום ש-
\begin_inset Formula 
\[
F_{k+1}\left(x\right)=\begin{cases}
F_{k}\left(x\right), & 1+\sum^{n-1}_{i=1}x_{i}2^{i-1}\leq k\\
1, & 1+\sum^{n-1}_{i=1}x_{i}2^{i-1}>k
\end{cases}.
\]

\end_inset

לכן עבור ה-
\begin_inset Formula $k$
\end_inset

 הראשון כך ש-
\begin_inset Formula $s<\sz{F_{k}}$
\end_inset

,
 אזי 
\begin_inset Formula $\sz{F_{k-1}}\leq s$
\end_inset

 ולכן 
\begin_inset Formula $\sz{F_{k}}\leq s+2n$
\end_inset

.
\end_layout

\end_deeper
\begin_layout Corollary
תהינא 
\begin_inset Formula $s,t:\mathbb{N}\rightarrow\mathbb{N}$
\end_inset

 כך ש-
\begin_inset Formula $s=o\left(t\right),n\leq t\left(n\right)$
\end_inset

.
\end_layout

\begin_layout Corollary
אזי 
\begin_inset Formula $\sz{s\left(n\right)}\subsetneq\sz{t\left(n\right)}$
\end_inset

.
\end_layout

\begin_deeper
\begin_layout Proof
כיוון ש-
\begin_inset Formula $s=o\left(t\right),n\leq t\left(n\right)$
\end_inset

 אזי 
\begin_inset Formula $s\left(n\right)+2n=O\left(t\right)$
\end_inset

.
 השפה המפרידה תהיה 
\begin_inset Formula $A$
\end_inset

 כך ש-
\begin_inset Formula $A_{n}=A\cap\left\{ 0,1\right\} ^{n}$
\end_inset

,
 ו-
\begin_inset Formula $\mathds{1}_{A_{n}}:\left\{ 0,1\right\} ^{n}\rightarrow\left\{ 0,1\right\} $
\end_inset

 זו פונקציה בסיבוכיות גדולה מ-
\begin_inset Formula $s\left(n\right)$
\end_inset

 ולכל היותר 
\begin_inset Formula $s\left(n\right)+2n$
\end_inset

.
\end_layout

\end_deeper
