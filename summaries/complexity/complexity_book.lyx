\begin_inset Formula $A\leq_{L}B$
\end_inset

 ו-
\begin_inset Formula $B\leq_{L}C$
\end_inset

 אז 
\begin_inset Formula $A\leq_{L}C$
\end_inset

.
\end_layout

\begin_layout Corollary
ניתן לחשב את 
\begin_inset Formula $\imm$
\end_inset

 (מכפלת 
\begin_inset Formula $n$
\end_inset

 מטריצות 
\begin_inset Formula $n\times n$
\end_inset

) בזכרון 
\begin_inset Formula $O\left(\log^{2}n\right)$
\end_inset

 ובזמן 
\begin_inset Formula $n^{O\left(\log n\right)}$
\end_inset

.
\end_layout

\begin_deeper
\begin_layout Proof
מתקיים 
\begin_inset Formula 
\[
\imm\left(A_{1},\ldots,A_{n}\right)=\imm\left(A_{1},\ldots,A_{n/2}\right)\cdot\imm\left(A_{n/2+1},\ldots,A_{n}\right),
\]

\end_inset

כלומר זו הרכבה של מכונה לכפל שתי מטריצות (בזכרון 
\begin_inset Formula $O\left(\log n\right)$
\end_inset

) עם שתי הפעלות של 
\begin_inset Formula $\imm$
\end_inset

 על 
\begin_inset Formula $n/2$
\end_inset

 מטריצות.
 יש 
\begin_inset Formula $\log n$
\end_inset

 רמות של הרכבה,
 כל רמה מוסיפה 
\begin_inset Formula $O\left(\log n\right)$
\end_inset

 לזכרון ומכפילה את הזמן בפולינום,
 ולכן הזכרון הוא 
\begin_inset Formula $O\left(\log^{2}n\right)$
\end_inset

 והזמן 
\begin_inset Formula $\poly\left(n\right)^{\log n}=n^{O\left(\log n\right)}$
\end_inset

.
\end_layout

\end_deeper
