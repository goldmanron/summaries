\end_layout

\begin_layout Standard
Let 
\begin_inset Formula \begin{align*}
a&=a_{1,2,3}+a_{1,3,4}+a_{2,3,4}+a_{1,2,4},\\
b&=b_{1,2,3}+b_{1,3,4}+b_{2,3,4}+b_{1,2,4}.
\end{align*}
\end_inset

The goal is to generate components 
\begin_inset Formula \begin{equation*}
c_{1,2,3},c_{1,3,4},c_{2,3,4},c_{1,2,4}
\end{equation*}
\end_inset

such that 
\begin_inset Formula \begin{equation*}
ab=c_{1,2,3}+c_{1,3,4}+c_{2,3,4}+c_{1,2,4}.
\end{equation*}
\end_inset


\end_layout

\begin_layout Standard
Expanding the product gives 
\begin_inset Formula \begin{equation*}
ab=
\sum_{I,J\in\binom{[4]}{3}}a_Ib_J.
\end{equation*}
\end_inset


\end_layout

\begin_layout Claim

\begin_inset Argument 1
status collapsed


\begin_layout Standard
Multiplication from shared monomials
\end_layout

\end_inset

If every monomial 
\begin_inset Formula $a_Ib_J$
\end_inset

 is correctly 
\begin_inset Formula $(4,1)$
\end_inset

-CNF-shared, then locally adding all corresponding share components produces a valid sharing of 
\begin_inset Formula $ab$
\end_inset

. 
\end_layout

\begin_layout Proof
The 
\begin_inset Formula $(4,1)$
\end_inset

-CNF sharing map is linear. Summing the four-component sharings of all monomials therefore yields a sharing whose reconstructed value is 
\begin_inset Formula \begin{equation*}
\sum_{I,J}a_Ib_J=ab.
\end{equation*}
\end_inset


\end_layout

\begin_layout Subsubsection
Subprotocol for Sharing a Monomial
\end_layout

\begin_layout Standard
For every 
\begin_inset Formula $I,J\in\binom{[4]}{3}$
\end_inset

, the intersection 
\begin_inset Formula $I\cap J$
\end_inset

 contains at least two parties. Choose two parties in this intersection. Both know 
\begin_inset Formula $a_I$
\end_inset

 and 
\begin_inset Formula $b_J$
\end_inset

, so both can compute 
\begin_inset Formula $a_Ib_J$
\end_inset

.
\end_layout

\begin_layout Claim

\begin_inset Argument 1
status collapsed


\begin_layout Standard
Actively secure monomial sharing
\end_layout

\end_inset

The parties can generate a correct VSS sharing of 
\begin_inset Formula $a_Ib_J$
\end_inset

 despite one active corruption. 
\end_layout

\begin_layout Proof
Let the two selected parties VSS-share values 
\begin_inset Formula $v$
\end_inset

 and 
\begin_inset Formula $w$
\end_inset

, respectively, where an honest selected party uses 
\begin_inset Formula \begin{equation*}
v=a_Ib_J
\qquad\text{or}\qquad
w=a_Ib_J.
\end{equation*}
\end_inset

At least one selected party is honest. The parties securely test whether 
\begin_inset Formula $v=w$
\end_inset

 by locally subtracting the two sharings and robustly opening the difference.
\end_layout

\begin_layout Proof
If 
\begin_inset Formula $v=w$
\end_inset

, retain either sharing. If 
\begin_inset Formula $v\neq w$
\end_inset

, one selected party is corrupted. Robustly recover 
\begin_inset Formula $a_I$
\end_inset

 and 
\begin_inset Formula $b_J$
\end_inset

, compute 
\begin_inset Formula $a_Ib_J$
\end_inset

, and locally set the shares to the canonical CNF sharing 
\begin_inset Formula \begin{equation*}
\operatorname{CNF\mbox{-}Share}(a_Ib_J;0,\ldots,0).
\end{equation*}
\end_inset

Thus the retained sharing always reconstructs to the correct monomial. 
\end_layout

\begin_layout Theorem

\begin_inset Argument 1
status collapsed


\begin_layout Standard
Active 
\begin_inset Formula $(4,1)$
\end_inset

-MPC
\end_layout

\end_inset


\begin_inset CommandInset label
LatexCommand label
name "thm:active-41-mpc"

\end_inset

 Every efficiently computable functionality has a four-party protocol with perfect active security against one corrupted party and polynomial complexity in the circuit size. 
\end_layout

\begin_layout Proof
Verifiable sharing fixes one consistent input for every party. Local addition preserves valid sharings. The multiplication protocol produces a valid sharing of every multiplication-gate output, and robust reconstruction prevents a corrupted party from changing the final output. Each interactive step is simulatable by the corresponding ideal VSS, multiplication, or reconstruction functionality. Sequential composition therefore gives perfect active security for the full circuit evaluation. 
\end_layout

