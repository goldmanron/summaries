\begin_inset CommandInset label
LatexCommand label
name "def:fss"

\end_inset

 Let 
\begin_inset Formula $\mathcal{F}$
\end_inset

 be a family of functions from a domain 
\begin_inset Formula $D$
\end_inset

 to a finite abelian group 
\begin_inset Formula $G$
\end_inset

. A two-party function secret-sharing scheme consists of probabilistic polynomial-time algorithms 
\begin_inset Formula \begin{align*}
(K_0,K_1)&\leftarrow\operatorname{Gen}(1^\lambda,f),\\
y_p&=\operatorname{Eval}(p,K_p,x),
\qquad p\in\{0,1\}.
\end{align*}
\end_inset

Correctness requires that for every 
\begin_inset Formula $f\in\mathcal{F}$
\end_inset

 and 
\begin_inset Formula $x\in D$
\end_inset

, 
\begin_inset Formula \begin{equation*}
\operatorname{Eval}(0,K_0,x)+
\operatorname{Eval}(1,K_1,x)=f(x)
\end{equation*}
\end_inset

with probability one. Privacy requires that for each 
\begin_inset Formula $p\in\{0,1\}$
\end_inset

 and every 
\begin_inset Formula $f_0,f_1\in\mathcal{F}$
\end_inset

 of the same public size, 
\begin_inset Formula \begin{equation*}
\{K_p:(K_0,K_1)\leftarrow\operatorname{Gen}(1^\lambda,f_0)\}
\approx_c
\{K_p:(K_0,K_1)\leftarrow\operatorname{Gen}(1^\lambda,f_1)\}.
\end{equation*}
\end_inset


\end_layout

