\begin_layout Subsubsection
Computational Secrecy [GM'82]
\end_layout

\begin_layout Definition

\begin_inset Argument 1
status collapsed


\begin_layout Standard

\begin_inset Formula $(t,\delta)$
\end_inset

-computational secrecy
\end_layout

\end_inset

An encryption scheme has 
\begin_inset Formula $(t,\delta)$
\end_inset

-computational secrecy if, for every 
\begin_inset Formula $X,Y\in\{0,1\}^n$
\end_inset

 and every probabilistic distinguisher 
\begin_inset Formula $A$
\end_inset

 of running time at most 
\begin_inset Formula $t$
\end_inset

, 
\begin_inset Formula \begin{equation*}
\left|\Pr_K[A(E_K(X))=1]-\Pr_K[A(E_K(Y))=1]\right|\leq\delta,
\qquad K\xleftarrow{R}\mathcal{K}.
\end{equation*}
\end_inset


\end_layout

