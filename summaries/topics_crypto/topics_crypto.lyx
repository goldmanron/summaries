nolink "false"
tuple "list"

\end_inset

 into a non-interactive proof satisfying Definition
\begin_inset space ~

\end_inset


\begin_inset CommandInset ref
LatexCommand ref
reference "def:pcp"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset

.
\end_layout

\begin_layout Standard
Let 
\begin_inset Formula $L$
\end_inset

 have an interactive proof 
\begin_inset Formula $(P,V)$
\end_inset

. On inputs of length 
\begin_inset Formula $n$
\end_inset

, assume that 
\begin_inset Formula $V$
\end_inset

 uses 
\begin_inset Formula $r(n)$
\end_inset

 random bits, communicates at most 
\begin_inset Formula $m(n)$
\end_inset

 bits with the prover, and that the protocol has perfect completeness and soundness error at most 
\begin_inset Formula $1/2$
\end_inset

.
\end_layout

\begin_layout Theorem

\begin_inset Argument 1
status collapsed


\begin_layout Standard
HW 5, Exercise 6
\end_layout

\end_inset


\begin_inset CommandInset label
LatexCommand label
name "thm:ip-to-pcp"

\end_inset

 The interactive proof gives a PCP for 
\begin_inset Formula $L$
\end_inset

 with proof length at most 
\begin_inset Formula \begin{equation*}
m(n)2^{m(n)+1},
\end{equation*}
\end_inset

query complexity at most 
\begin_inset Formula $m(n)$
\end_inset

, and soundness error at most 
\begin_inset Formula $1/2$
\end_inset

. 
\end_layout

\begin_layout Proof
Construct the proof string 
\begin_inset Formula $\pi$
\end_inset

 as a lookup table indexed by every possible verifier-message history 
\begin_inset Formula \begin{equation*}
h\in\{0,1\}^{\leq m(n)}.
\end{equation*}
\end_inset

For every history 
\begin_inset Formula $h$
\end_inset

, the entry 
\begin_inset Formula $\pi[h]$
\end_inset

 contains the bits that the deterministic honest prover 
\begin_inset Formula $P$
\end_inset

 would send in response.
\end_layout

\begin_layout Proof
The PCP verifier 
\begin_inset Formula $V^\pi_{\mathrm{PCP}}(x)$
\end_inset

 samples a random tape 
\begin_inset Formula \begin{equation*}
r\xleftarrow{R}\{0,1\}^{r(n)}
\end{equation*}
\end_inset

and initializes a simulated verifier 
\begin_inset Formula $V(x;r)$
\end_inset

 with history 
\begin_inset Formula $h=\emptyset$
\end_inset

. In each round, when 
\begin_inset Formula $V$
\end_inset

 outputs a message, 
\begin_inset Formula $V_{\mathrm{PCP}}$
\end_inset

 appends it to 
\begin_inset Formula $h$
\end_inset

, queries 
\begin_inset Formula $\pi[h]$
\end_inset

 for the prover's response, and feeds this response back to 
\begin_inset Formula $V$
\end_inset

. The PCP verifier accepts if and only if the simulated verifier accepts.
\end_layout

\begin_layout Proof

\emph on
Length of the proof string.
\emph default
 The verifier sends at most 
\begin_inset Formula $m(n)$
\end_inset

 bits throughout the interactive protocol. Thus the number of possible histories is at most 
\begin_inset Formula \begin{equation*}
\sum_{i=0}^{m(n)}2^i
=2^{m(n)+1}-1.
\end{equation*}
\end_inset

For each history, the prover's response is at most 
\begin_inset Formula $m(n)$
\end_inset

 bits long. Therefore the total proof length is bounded by 
\begin_inset Formula \begin{equation*}
m(n)\cdot2^{m(n)+1}
\end{equation*}
\end_inset

bits.
\end_layout

\begin_layout Proof

\emph on
Number of queries.
\emph default
 The verifier queries only prover responses along one execution path. Since the total communication in one execution is at most 
\begin_inset Formula $m(n)$
\end_inset

 bits, it reads at most 
\begin_inset Formula $m(n)$
\end_inset

 proof bits.
\end_layout

\begin_layout Proof

\emph on
Soundness.
\emph default
 Assume 
\begin_inset Formula $x\notin L$
\end_inset

. Every proof string 
\begin_inset Formula $\pi^*$
\end_inset

 defines a fixed deterministic cheating prover strategy 
\begin_inset Formula $P^*$
\end_inset

 for the interactive protocol. By construction, 
\begin_inset Formula \begin{equation*}
V^{\pi^*}_{\mathrm{PCP}}(x)=1
\end{equation*}
\end_inset

if and only if 
\begin_inset Formula $V(x;r)$
\end_inset

 accepts when interacting with 
\begin_inset Formula $P^*$
\end_inset

. Hence the acceptance probability is exactly 
\begin_inset Formula \begin{equation*}
\Pr[(P^*,V)(x)=1]\leq\frac12,
\end{equation*}
\end_inset

by the soundness of the original interactive proof. 
\end_layout

