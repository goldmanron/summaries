\begin_layout Subsubsection
Recursive Optimization
\end_layout

\begin_layout Standard
Arrange the database as 
\begin_inset Formula $N^{1-\alpha}$
\end_inset

 rows of length 
\begin_inset Formula $N^\alpha$
\end_inset

. The first evaluation layer produces 
\begin_inset Formula \begin{equation*}
a_1,\ldots,a_{N^{1-\alpha}},
\qquad
a_r=\operatorname{Eval}(f_r,q),
\end{equation*}
\end_inset

The same construction is applied recursively to the encrypted answer vector.
\end_layout

\begin_layout Theorem

\begin_inset Argument 1
status collapsed


\begin_layout Standard
Recursive AHE communication bound
\end_layout

\end_inset


\begin_inset CommandInset label
LatexCommand label
name "thm:ahe-recursion"

\end_inset

 Let a field element be encrypted by 
\begin_inset Formula $\kappa$
\end_inset

 field elements, and assume 
\begin_inset Formula $d=1/\alpha\in\mathbb{N}$
\end_inset

. The recursive communication satisfies the formal recurrence 
\begin_inset Formula \begin{equation*}
T(N)=\kappa N^\alpha+T\bigl(\kappa N^{1-\alpha}\bigr).
\end{equation*}
\end_inset

With recursion depth 
\begin_inset Formula $d$
\end_inset

, the query and answer lengths are 
\begin_inset Formula \begin{equation*}
\text{user-to-server communication}
=d\kappa N^\alpha,
\end{equation*}
\end_inset

and 
\begin_inset Formula \begin{equation*}
\text{server-to-user communication}=\kappa^d.
\end{equation*}
\end_inset

If 
\begin_inset Formula $\kappa=N^\beta$
\end_inset

, these are respectively 
\begin_inset Formula \begin{equation*}
O(N^{\alpha+\beta})
\quad\text{and}\quad
O(N^{\beta/\alpha}).
\end{equation*}
\end_inset

Consequently, communication 
\begin_inset Formula $O(N^\epsilon)$
\end_inset

 is achievable for every 
\begin_inset Formula $\epsilon>0$
\end_inset

 by taking 
\begin_inset Formula \begin{equation*}
\alpha=\frac{\epsilon}{2},
\qquad
\beta=\frac{\epsilon^2}{2}.
\end{equation*}
\end_inset


\end_layout

\begin_layout Proof
At each of the 
\begin_inset Formula $d$
\end_inset

 levels, the query contains 
\begin_inset Formula $N^\alpha$
\end_inset

 ciphertexts, for 
\begin_inset Formula $d\kappa N^\alpha$
\end_inset

 field elements. The recursive process leaves a single ciphertext whose expansion through 
\begin_inset Formula $d$
\end_inset

 encryption layers has size 
\begin_inset Formula $\kappa^d$
\end_inset

. Substituting 
\begin_inset Formula $\kappa=N^\beta$
\end_inset

 yields the displayed exponents. With the chosen 
\begin_inset Formula $\alpha,\beta$
\end_inset

, both exponents are at most 
\begin_inset Formula $\epsilon$
\end_inset

. 
\end_layout

