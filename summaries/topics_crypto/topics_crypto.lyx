\begin_layout Standard
1-private 
\begin_inset Formula $k$
\end_inset

-server PIR
\end_layout

\end_inset


\begin_inset CommandInset label
LatexCommand label
name "def:it-pir"

\end_inset

 A 1-private 
\begin_inset Formula $k$
\end_inset

-server PIR protocol for 
\begin_inset Formula $N$
\end_inset

-bit databases consists of a finite randomness space 
\begin_inset Formula $\mathcal{R}$
\end_inset

, query spaces 
\begin_inset Formula $\mathcal{Q}_1,\ldots,\mathcal{Q}_k$
\end_inset

, answer spaces 
\begin_inset Formula $\mathcal{A}_1,\ldots,\mathcal{A}_k$
\end_inset

, and maps 
\begin_inset Formula \begin{align*}
Q&:[N]\times\mathcal{R}
\longrightarrow
\mathcal{Q}_1\times\cdots\times\mathcal{Q}_k,\\
A_s&:\{0,1\}^N\times\mathcal{Q}_s
\longrightarrow\mathcal{A}_s,
\qquad s\in[k],\\
D&:[N]\times\mathcal{R}\times
\mathcal{A}_1\times\cdots\times\mathcal{A}_k
\longrightarrow\{0,1\}.
\end{align*}
\end_inset


\end_layout

\begin_layout Definition
For 
\begin_inset Formula $i\in[N]$
\end_inset

, 
\begin_inset Formula $r\in\mathcal{R}$
\end_inset

, and 
\begin_inset Formula $x\in\{0,1\}^N$
\end_inset

, write 
\begin_inset Formula \begin{equation*}
(q_1,\ldots,q_k)=Q(i,r),
\qquad
a_s=A_s(x,q_s).
\end{equation*}
\end_inset

The protocol satisfies the following conditions. 
\end_layout

\begin_deeper
\begin_layout Enumerate

\emph on
Perfect correctness:
\emph default
 for every 
\begin_inset Formula $x\in\{0,1\}^N$
\end_inset

, 
\begin_inset Formula $i\in[N]$
\end_inset

, and 
\begin_inset Formula $r\in\mathcal{R}$
\end_inset

, 
\begin_inset Formula \begin{equation*}
D(i,r,a_1,\ldots,a_k)=x[i].
\end{equation*}
\end_inset


\end_layout

\begin_layout Enumerate

\emph on
Perfect 1-privacy:
\emph default
 for every 
\begin_inset Formula $s\in[k]$
\end_inset

 and every 
\begin_inset Formula $i,i'\in[N]$
\end_inset

, 
\begin_inset Formula \begin{equation*}
Q_s(i,R)\equiv Q_s(i',R),
\qquad R\xleftarrow{R}\mathcal{R},
\end{equation*}
\end_inset

where 
\begin_inset Formula $Q_s$
\end_inset

 is the 
\begin_inset Formula $s$
\end_inset

-th component of 
\begin_inset Formula $Q$
\end_inset

. 
\end_layout

\end_deeper
\begin_layout Definition
The communication complexity of an execution is 
\begin_inset Formula \begin{equation*}
\sum_{s=1}^k\bigl(|q_s|+|a_s|\bigr).
\end{equation*}
\end_inset


\end_layout

\begin_layout Standard
Unless stated otherwise, each answer has length 
\begin_inset Formula $O(1)$
\end_inset

 bits.
\end_layout

\begin_layout Subsubsection
Impossibility of Non-Trivial Single-Server PIR
\end_layout

\begin_layout Theorem

\begin_inset Argument 1
status collapsed


\begin_layout Standard
HW 2, Exercise 1
\end_layout

\end_inset

In every perfectly correct, perfectly private single-server PIR protocol for 
\begin_inset Formula $N$
\end_inset

-bit databases, the answer length is at least 
\begin_inset Formula $N$
\end_inset

 bits. 
\end_layout

\begin_layout Proof
By perfect privacy, the random variables 
\begin_inset Formula $Q(i,R)$
\end_inset

 have the same distribution for all 
\begin_inset Formula $i\in[N]$
\end_inset

. Fix a query 
\begin_inset Formula $q$
\end_inset

 in their common support. For every 
\begin_inset Formula $i\in[N]$
\end_inset

, choose 
\begin_inset Formula $r_i\in\mathcal{R}$
\end_inset

 such that 
\begin_inset Formula $Q(i,r_i)=q$
\end_inset

.
\end_layout

\begin_layout Proof
Suppose that the answer length is 
\begin_inset Formula $t$
\end_inset

, and define 
\begin_inset Formula \begin{equation*}
F_q:\{0,1\}^N\longrightarrow\{0,1\}^t,
\qquad F_q(x)=A(x,q),
\end{equation*}
\end_inset

where 
\begin_inset Formula $A$
\end_inset

 is the answer map. The map 
\begin_inset Formula $F_q$
\end_inset

 is injective. Indeed, suppose 
\begin_inset Formula $F_q(x)=F_q(x')$
\end_inset

 for distinct 
\begin_inset Formula $x,x'\in\{0,1\}^N$
\end_inset

, and choose 
\begin_inset Formula $i\in[N]$
\end_inset

 such that 
\begin_inset Formula $x[i]\neq x'[i]$
\end_inset

. Perfect correctness with randomness 
\begin_inset Formula $r_i$
\end_inset

 requires 
\begin_inset Formula \begin{equation*}
D(i,r_i,F_q(x))=x[i]
\quad\text{and}\quad
D(i,r_i,F_q(x'))=x'[i],
\end{equation*}
\end_inset

which contradicts 
\begin_inset Formula $F_q(x)=F_q(x')$
\end_inset

. Hence 
\begin_inset Formula \begin{equation*}
2^N\leq2^t,
\end{equation*}
\end_inset

and therefore 
\begin_inset Formula $t\geq N$
\end_inset

. 
\end_layout

\begin_layout Subsubsection
PIR over Longer Records
\end_layout

\begin_layout Theorem

\begin_inset Argument 1
status collapsed


\begin_layout Standard
HW 2, Exercise 2
\end_layout

\end_inset

Let 
\begin_inset Formula $(Q,A_1,\ldots,A_k,D)$
\end_inset

 be a perfectly correct, perfectly 1-private PIR for databases in 
\begin_inset Formula $\{0,1\}^N$
\end_inset

. Then there is a perfectly correct, perfectly 1-private PIR for databases in 
\begin_inset Formula $(\{0,1\}^b)^N$
\end_inset

 with the same query algorithm and with each answer length multiplied by 
\begin_inset Formula $b$
\end_inset

. 
\end_layout

\begin_layout Proof
For 
\begin_inset Formula \begin{equation*}
x=(x[1],\ldots,x[N])\in(\{0,1\}^b)^N
\end{equation*}
\end_inset

define 
\begin_inset Formula $x^{(1)},\ldots,x^{(b)}\in\{0,1\}^N$
\end_inset

 by 
\begin_inset Formula \begin{equation*}
x^{(\ell)}[i]=x[i]_\ell,
\qquad i\in[N],\ \ell\in[b].
\end{equation*}
\end_inset

Use the original query algorithm. For every 
\begin_inset Formula $s\in[k]$
\end_inset

, define 
\begin_inset Formula \begin{equation*}
\widetilde A_s(x,q_s)
=\bigl(A_s(x^{(1)},q_s),\ldots,A_s(x^{(b)},q_s)\bigr).
\end{equation*}
\end_inset

If 
\begin_inset Formula $\widetilde a_s=(a_s^{(1)},\ldots,a_s^{(b)})$
\end_inset

, define 
\begin_inset Formula \begin{equation*}
\widetilde D(i,r,\widetilde a_1,\ldots,\widetilde a_k)
=\bigl(D(i,r,a_1^{(\ell)},\ldots,a_k^{(\ell)})\bigr)_{\ell=1}^b.
\end{equation*}
\end_inset

Perfect correctness of the original protocol implies 
\begin_inset Formula \begin{equation*}
\widetilde D(i,r,\widetilde a_1,\ldots,\widetilde a_k)=x[i].
\end{equation*}
\end_inset

The query distribution is unchanged, so perfect 1-privacy is preserved. Each new answer concatenates 
\begin_inset Formula $b$
\end_inset

 original answers. 
\end_layout

\begin_layout Standard
Applied to the Hadamard protocol, this transformation gives a two-server PIR for 
\begin_inset Formula $b$
\end_inset

-bit records.
\end_layout

