\begin_layout Subsubsection
Explicit GMW Protocol for 
\begin_inset Formula $f(w,x,y,z)=wy+xz$
\end_inset


\end_layout

\begin_layout Standard
Alice holds 
\begin_inset Formula $w,x$
\end_inset

, Bob holds 
\begin_inset Formula $y,z$
\end_inset

, and Alice receives the output.
\end_layout

\begin_layout Theorem

\begin_inset Argument 1
status collapsed


\begin_layout Standard
HW 4, Exercise 2
\end_layout

\end_inset

The following OT-hybrid protocol securely computes 
\begin_inset Formula \begin{equation*}
f(w,x,y,z)=wy+xz.
\end{equation*}
\end_inset


\end_layout

\begin_layout Proof
Alice samples 
\begin_inset Formula $w_2,x_2\xleftarrow{R}\mathbb{F}$
\end_inset

, sends them to Bob, and keeps 
\begin_inset Formula \begin{equation*}
w_1=w-w_2,
\qquad
x_1=x-x_2.
\end{equation*}
\end_inset

Bob samples 
\begin_inset Formula $y_1,z_1\xleftarrow{R}\mathbb{F}$
\end_inset

, sends them to Alice, and keeps 
\begin_inset Formula \begin{equation*}
y_2=y-y_1,
\qquad
z_2=z-z_1.
\end{equation*}
\end_inset


\end_layout

\begin_layout Proof
For shared 
\begin_inset Formula $a=a_1+a_2$
\end_inset

 and 
\begin_inset Formula $b=b_1+b_2$
\end_inset

, the parties produce shares of 
\begin_inset Formula $ab$
\end_inset

 as follows. Alice samples 
\begin_inset Formula $\alpha\in\mathbb{F}$
\end_inset

 and is the OT sender with 
\begin_inset Formula \begin{equation*}
M_s=a_1s-\alpha,
\qquad s\in\mathbb{F}.
\end{equation*}
\end_inset

Bob selects 
\begin_inset Formula $b_2$
\end_inset

 and receives 
\begin_inset Formula \begin{equation*}
U=a_1b_2-\alpha.
\end{equation*}
\end_inset

Bob samples 
\begin_inset Formula $\beta\in\mathbb{F}$
\end_inset

 and is the OT sender with 
\begin_inset Formula \begin{equation*}
N_s=a_2s-\beta,
\qquad s\in\mathbb{F}.
\end{equation*}
\end_inset

Alice selects 
\begin_inset Formula $b_1$
\end_inset

 and receives 
\begin_inset Formula \begin{equation*}
V=a_2b_1-\beta.
\end{equation*}
\end_inset

They define 
\begin_inset Formula \begin{equation*}
c_1=a_1b_1+V+\alpha,
\qquad
c_2=a_2b_2+U+\beta.
\end{equation*}
\end_inset

Then 
\begin_inset Formula \begin{align*}
c_1+c_2
&=a_1b_1+a_2b_1-\beta+\alpha
  +a_2b_2+a_1b_2-\alpha+\beta\\
&=(a_1+a_2)(b_1+b_2)=ab.
\end{align*}
\end_inset


\end_layout

\begin_layout Proof
Run this multiplication protocol for 
\begin_inset Formula $(w,y)$
\end_inset

 to obtain 
\begin_inset Formula $p_1+p_2=wy$
\end_inset

, and independently for 
\begin_inset Formula $(x,z)$
\end_inset

 to obtain 
\begin_inset Formula $q_1+q_2=xz$
\end_inset

. Alice sets 
\begin_inset Formula $t_1=p_1+q_1$
\end_inset

, Bob sets 
\begin_inset Formula $t_2=p_2+q_2$
\end_inset

 and sends 
\begin_inset Formula $t_2$
\end_inset

 to Alice. Alice outputs 
\begin_inset Formula \begin{equation*}
t_1+t_2=wy+xz.
\end{equation*}
\end_inset


\end_layout

\begin_layout Proof
For privacy against Alice, a simulator given 
\begin_inset Formula $(w,x)$
\end_inset

 and 
\begin_inset Formula $t=wy+xz$
\end_inset

 samples 
\begin_inset Formula \begin{equation*}
w_2,x_2,\alpha_p,\alpha_q,y_1,z_1,V_p,V_q
\xleftarrow{R}\mathbb{F}
\end{equation*}
\end_inset

independently. It sets 
\begin_inset Formula $w_1=w-w_2$
\end_inset

 and 
\begin_inset Formula $x_1=x-x_2$
\end_inset

, forms Alice's two OT sender tables 
\begin_inset Formula \begin{equation*}
M^p_s=w_1s-\alpha_p,
\qquad
M^q_s=x_1s-\alpha_q,
\end{equation*}
\end_inset

and treats 
\begin_inset Formula $V_p,V_q$
\end_inset

 as her two reverse-OT answers. It computes 
\begin_inset Formula \begin{align*}
p_1&=w_1y_1+V_p+\alpha_p,\\
q_1&=x_1z_1+V_q+\alpha_q,\\
t_1&=p_1+q_1,
\end{align*}
\end_inset

and sets the final message to 
\begin_inset Formula $t_2=t-t_1$
\end_inset

. Each sampled value has the same uniform distribution as in the real execution, and the sole final constraint is exactly correctness. Thus the simulated and real views are identically distributed. The simulator against Bob is symmetric. 
\end_layout

