\begin_layout Subsubsection
Perfect Secrecy
\end_layout

\begin_layout Definition

\begin_inset Argument 1
status collapsed


\begin_layout Standard
Perfect secrecy
\end_layout

\end_inset


\begin_inset CommandInset label
LatexCommand label
name "def:perfect-secrecy"

\end_inset

 For every 
\begin_inset Formula $X,Y\in\{0,1\}^n$
\end_inset

, 
\begin_inset Formula \begin{equation*}
E_K(X)\equiv E_K(Y),
\qquad K\xleftarrow{R}\mathcal{K}.
\end{equation*}
\end_inset

Equivalently, for every 
\begin_inset Formula $C\in\mathcal{C}$
\end_inset

, 
\begin_inset Formula \begin{equation*}
\Pr_K[E_K(X)=C]=\Pr_K[E_K(Y)=C].
\end{equation*}
\end_inset


\end_layout

