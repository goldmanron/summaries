\begin_layout Subsubsection
Every Two-Party Function Reduces to Inner Product
\end_layout

\begin_layout Theorem

\begin_inset Argument 1
status collapsed


\begin_layout Standard
Reduction to inner product
\end_layout

\end_inset

Every two-party Boolean function can be expressed as an inner product of values computed locally by Alice and Bob. 
\end_layout

\begin_layout Proof
Write 
\begin_inset Formula $f$
\end_inset

 as a multilinear polynomial over the binary field. For example, 
\begin_inset Formula \begin{multline*}
f(x,y)=x_1x_5y_6y_{10}+x_2x_3x_4y_1y_2+x_1x_2x_{10}+x_3\\
+y_1y_2y_{20}+y_2y_{21}.
\end{multline*}
\end_inset

Alice locally defines 
\begin_inset Formula \begin{equation*}
X_1=x_1x_5,
\quad
X_2=x_2x_3x_4,
\quad
X_{\mathrm{pure}}=x_1x_2x_{10}+x_3,
\end{equation*}
\end_inset

and Bob locally defines 
\begin_inset Formula \begin{equation*}
Y_1=y_6y_{10},
\quad
Y_2=y_1y_2,
\quad
Y_{\mathrm{pure}}=y_1y_2y_{20}+y_2y_{21}.
\end{equation*}
\end_inset

Then 
\begin_inset Formula $f(x,y)$
\end_inset

 is the inner product of 
\begin_inset Formula \begin{equation*}
(X_1,X_2,X_{\mathrm{pure}},1)
\end{equation*}
\end_inset

with 
\begin_inset Formula \begin{equation*}
(Y_1,Y_2,1,Y_{\mathrm{pure}}).
\end{equation*}
\end_inset

The communication and computation are proportional to the number of mixed monomials, which may be exponential in the input length. The advantage is a single round of OT calls. 
\end_layout

\begin_layout Subsection
The Two-Party GMW Protocol
\end_layout

\begin_layout Standard
Represent 
\begin_inset Formula $f$
\end_inset

 by an arithmetic circuit over the binary field. Alice and Bob scan the circuit while maintaining the invariant that for every wire of value 
\begin_inset Formula $v$
\end_inset

, they hold random shares 
\begin_inset Formula $v_1,v_2$
\end_inset

 satisfying 
\begin_inset Formula \begin{equation*}
v_1+v_2=v.
\end{equation*}
\end_inset


\end_layout

