\end_layout

\end_inset


\end_layout

\end_inset


\end_layout

\begin_layout Definition

\begin_inset Argument 1
status collapsed


\begin_layout Standard
Adversarial indistinguishability
\end_layout

\end_inset

The cipher is adversarial indistinguishable if, for every adversary 
\begin_inset Formula $\mathcal{A}$
\end_inset

, 
\begin_inset Formula \begin{equation*}
\Pr[b=b']=\frac{1}{2}.
\end{equation*}
\end_inset


\end_layout

\begin_layout Theorem

\begin_inset Argument 1
status collapsed


\begin_layout Standard
Equivalence of the two definitions
\end_layout

\end_inset

A cipher is adversarial indistinguishable if and only if it is perfectly indistinguishable. Namely, 
\begin_inset Formula \begin{multline*}
\forall m_0,m_1\in\mathcal{M},\ \forall c\in\mathcal{C}:\quad
\Pr_K[E_K(m_0)=c]=\Pr_K[E_K(m_1)=c]\\
\Longleftrightarrow\quad
\Pr[b=b']=\frac{1}{2}
\quad\text{for every adversary }\mathcal{A}.
\end{multline*}
\end_inset


\end_layout

\begin_layout Proof
Suppose first that the cipher is perfectly indistinguishable. For the two messages selected by 
\begin_inset Formula $\mathcal{A}$
\end_inset

, the distribution of 
\begin_inset Formula $E_K(m_0)$
\end_inset

 is identical to the distribution of 
\begin_inset Formula $E_K(m_1)$
\end_inset

. Hence the challenge ciphertext is independent of the uniform bit 
\begin_inset Formula $b$
\end_inset

, and every adversary satisfies 
\begin_inset Formula $\Pr[b=b']=1/2$
\end_inset

.
\end_layout

\begin_layout Proof
Conversely, suppose perfect indistinguishability fails. Then there exist 
\begin_inset Formula $m_0,m_1\in\mathcal{M}$
\end_inset

 and 
\begin_inset Formula $c\in\mathcal{C}$
\end_inset

 such that 
\begin_inset Formula \begin{equation*}
p_0:=\Pr_K[E_K(m_0)=c]\neq
p_1:=\Pr_K[E_K(m_1)=c].
\end{equation*}
\end_inset

After exchanging the messages if needed, assume 
\begin_inset Formula $p_0>p_1$
\end_inset

. Let 
\begin_inset Formula $\mathcal{A}$
\end_inset

 output 
\begin_inset Formula $b'=0$
\end_inset

 when the challenge ciphertext is 
\begin_inset Formula $c$
\end_inset

, and output 
\begin_inset Formula $b'=1$
\end_inset

 otherwise. Then 
\begin_inset Formula \begin{equation*}
\Pr[b=b']
=\frac{1}{2}p_0+\frac{1}{2}(1-p_1)
=\frac{1}{2}+\frac{p_0-p_1}{2}
>\frac{1}{2}.
\end{equation*}
\end_inset

Thus the cipher is not adversarial indistinguishable. 
\end_layout

\begin_layout Subsection
One-Time Pad Is Perfectly Secure
\end_layout

\begin_layout Standard
For 
\begin_inset Formula $M\in\{0,1\}^n$
\end_inset

, sample 
\begin_inset Formula $K\xleftarrow{R}\{0,1\}^n$
\end_inset

 and define 
\begin_inset Formula \begin{equation*}
E_K(M)=K\oplus M,
\qquad
D_K(C)=C\oplus K.
\end{equation*}
\end_inset


\end_layout

\begin_layout Theorem

\begin_inset Argument 1
status collapsed


\begin_layout Standard
One-time pad security
\end_layout

\end_inset


\begin_inset CommandInset label
LatexCommand label
name "thm:otp-security"

\end_inset

 For every 
\begin_inset Formula $X,Y$
\end_inset

, 
\begin_inset Formula $E_K(X)\equiv E_K(Y)$
\end_inset

. Thus the one-time pad is perfectly secure. 
\end_layout

\begin_layout Proof
More generally, let 
\begin_inset Formula $G$
\end_inset

 be a finite group and let 
\begin_inset Formula $K$
\end_inset

 be uniform in 
\begin_inset Formula $G$
\end_inset

. For every 
\begin_inset Formula $X,C\in G$
\end_inset

, 
\begin_inset Formula \begin{equation*}
\Pr_K[E_K(X)=C]
=\Pr_K[K+X=C]
=\Pr_K[K=C-X]
=\frac{1}{|G|}.
\end{equation*}
\end_inset

Put differently: for every 
\begin_inset Formula $X$
\end_inset

, the mapping 
\begin_inset Formula $K\mapsto E_K(X)$
\end_inset

 is a bijection from randomness space to ciphertext space. In fact, it is a non-degenerate linear mapping. 
\end_layout

