\begin_layout Subsection
The Schwartz–Zippel Lemma
\end_layout

\begin_layout Lemma

\begin_inset Argument 1
status collapsed


\begin_layout Standard
Schwartz–Zippel
\end_layout

\end_inset


\begin_inset CommandInset label
LatexCommand label
name "lem:schwartz-zippel"

\end_inset

 Let 
\begin_inset Formula $\mathbb{F}$
\end_inset

 be a finite field, and let 
\begin_inset Formula \begin{equation*}
f(x_1,\ldots,x_m)\in\mathbb{F}[x_1,\ldots,x_m]
\end{equation*}
\end_inset

be a nonzero polynomial of total degree at most 
\begin_inset Formula $d$
\end_inset

. Then 
\begin_inset Formula \begin{equation*}
\Pr_{a_1,\ldots,a_m\xleftarrow{R}\mathbb{F}}
[f(a_1,\ldots,a_m)=0]
\leq\frac{d}{|\mathbb{F}|},
\end{equation*}
\end_inset

where each 
\begin_inset Formula $a_i$
\end_inset

 is chosen independently and uniformly at random from 
\begin_inset Formula $\mathbb{F}$
\end_inset

. 
\end_layout

\begin_layout Proof
We prove the lemma by induction on 
\begin_inset Formula $m$
\end_inset

.
\end_layout

\begin_layout Proof

\emph on
Basis.
\emph default
 If 
\begin_inset Formula $m=1$
\end_inset

, then a nonzero univariate polynomial has at most 
\begin_inset Formula $\deg f$
\end_inset

 roots in 
\begin_inset Formula $\mathbb{F}$
\end_inset

. Thus 
\begin_inset Formula \begin{equation*}
\Pr_{a\xleftarrow{R}\mathbb{F}}[f(a)=0]
\leq
\frac{|\{a\in\mathbb{F}:f(a)=0\}|}{|\mathbb{F}|}
\leq\frac{\deg f}{|\mathbb{F}|}
\leq\frac{d}{|\mathbb{F}|}.
\end{equation*}
\end_inset


\end_layout

\begin_layout Proof

\emph on
Step.
\emph default
 Assume the lemma holds for 
\begin_inset Formula $m-1$
\end_inset

. Since we sample 
\begin_inset Formula $a$
\end_inset

 uniformly from 
\begin_inset Formula $\mathbb{F}^m$
\end_inset

, write 
\begin_inset Formula \begin{equation*}
a=(b,c),
\qquad
b\xleftarrow{R}\mathbb{F}^{m-1},
\qquad
c\xleftarrow{R}\mathbb{F}.
\end{equation*}
\end_inset

Let 
\begin_inset Formula $k$
\end_inset

 be the maximum degree of 
\begin_inset Formula $x_m$
\end_inset

 in 
\begin_inset Formula $f$
\end_inset

. Write 
\begin_inset Formula $f$
\end_inset

 as a polynomial in 
\begin_inset Formula $x_m$
\end_inset

 with coefficients in 
\begin_inset Formula $\mathbb{F}[x_1,\ldots,x_{m-1}]$
\end_inset

: 
\begin_inset Formula \begin{equation*}
f(x_1,\ldots,x_m)
=\sum_{i=0}^{k}g_i(x_1,\ldots,x_{m-1})x_m^i.
\end{equation*}
\end_inset

Since 
\begin_inset Formula $k$
\end_inset

 is the maximum degree of 
\begin_inset Formula $x_m$
\end_inset

, the polynomial 
\begin_inset Formula $g_k$
\end_inset

 is nonzero. Moreover, because the total degree of 
\begin_inset Formula $f$
\end_inset

 is at most 
\begin_inset Formula $d$
\end_inset

, the total degree of 
\begin_inset Formula $g_k$
\end_inset

 is at most 
\begin_inset Formula $d-k$
\end_inset

.
\end_layout

\begin_layout Proof
By the law of total probability, condition on whether 
\begin_inset Formula $b$
\end_inset

 is a root of 
\begin_inset Formula $g_k$
\end_inset

: 
\begin_inset Formula \begin{align*}
\Pr[f(b,c)=0]
={}&\Pr[g_k(b)=0]\Pr[f(b,c)=0\mid g_k(b)=0]\\
&+\Pr[g_k(b)\neq0]\Pr[f(b,c)=0\mid g_k(b)\neq0].
\end{align*}
\end_inset

Replacing the unneeded probabilities by 
\begin_inset Formula $1$
\end_inset

 gives 
\begin_inset Formula \begin{equation*}
\Pr[f(a)=0]
\leq
\Pr[g_k(b)=0]
+\Pr[f(b,c)=0\mid g_k(b)\neq0].
\end{equation*}
\end_inset


\end_layout

\begin_layout Proof
For the first term, 
\begin_inset Formula $g_k$
\end_inset

 is a nonzero polynomial in 
\begin_inset Formula $m-1$
\end_inset

 variables of total degree at most 
\begin_inset Formula $d-k$
\end_inset

. By the induction hypothesis, 
\begin_inset Formula \begin{equation*}
\Pr_{b\xleftarrow{R}\mathbb{F}^{m-1}}[g_k(b)=0]
\leq\frac{d-k}{|\mathbb{F}|}.
\end{equation*}
\end_inset


\end_layout

\begin_layout Proof
For the second term, condition on a fixed 
\begin_inset Formula $b$
\end_inset

 such that 
\begin_inset Formula $g_k(b)\neq0$
\end_inset

. Then 
\begin_inset Formula $f(b,x_m)$
\end_inset

 is a nonzero univariate polynomial in 
\begin_inset Formula $x_m$
\end_inset

 of degree exactly 
\begin_inset Formula $k$
\end_inset

, since its leading coefficient 
\begin_inset Formula $g_k(b)$
\end_inset

 is nonzero. By the base case, the probability that a random 
\begin_inset Formula $c\xleftarrow{R}\mathbb{F}$
\end_inset

 is a root is at most 
\begin_inset Formula \begin{equation*}
\frac{k}{|\mathbb{F}|}.
\end{equation*}
\end_inset

Therefore, 
\begin_inset Formula \begin{equation*}
\Pr[f(a)=0]
\leq
\frac{d-k}{|\mathbb{F}|}+
\frac{k}{|\mathbb{F}|}
=\frac{d}{|\mathbb{F}|}.
\end{equation*}
\end_inset


\end_layout

\begin_layout Subsection
Soundness of Sum Check
\end_layout

\begin_layout Standard
Assume 
\begin_inset Formula \begin{equation*}
s_0\neq\sum_{x\in\{0,1\}^n}p(x).
\end{equation*}
\end_inset

Let 
\begin_inset Formula $P^*$
\end_inset

 be a cheating prover, and let 
\begin_inset Formula \begin{equation*}
\widetilde p_1,r_1,\ldots,\widetilde p_n,r_n
\end{equation*}
\end_inset

be the transcript of 
\begin_inset Formula $(P^*,V)$
\end_inset

. Let 
\begin_inset Formula $p_i$
\end_inset

 denote the message sent by the honest prover: 
\begin_inset Formula \begin{equation*}
p_i(y)=
\sum_{x_{i+1},\ldots,x_n\in\{0,1\}}
p(r_1,\ldots,r_{i-1},y,x_{i+1},\ldots,x_n).
\end{equation*}
\end_inset


\end_layout

\begin_layout Standard
If 
\begin_inset Formula $p_1\equiv\widetilde p_1$
\end_inset

, then 
\begin_inset Formula \begin{equation*}
\widetilde p_1(0)+\widetilde p_1(1)\neq s_0
\end{equation*}
\end_inset

and the verifier rejects in the first round. If 
\begin_inset Formula $p_1\not\equiv\widetilde p_1$
\end_inset

, then 
\begin_inset Formula $p_1-\widetilde p_1$
\end_inset

 is a nonzero degree-
\begin_inset Formula $d$
\end_inset

 polynomial. By Lemma
\begin_inset space ~

\end_inset


\begin_inset CommandInset ref
LatexCommand ref
reference "lem:schwartz-zippel"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset

, 
\begin_inset Formula \begin{equation*}
\Pr_{r_1\xleftarrow{R}\mathbb{F}}
[p_1(r_1)=\widetilde p_1(r_1)]
\leq\frac{d}{|\mathbb{F}|}.
\end{equation*}
\end_inset

Thus 
\begin_inset Formula \begin{equation*}
s_1=\widetilde p_1(r_1)
\neq p_1(r_1)
=\sum_{x_2,\ldots,x_n\in\{0,1\}}
p(r_1,x_2,\ldots,x_n)
\end{equation*}
\end_inset

except with probability 
\begin_inset Formula $d/|\mathbb{F}|$
\end_inset

.
\end_layout

\begin_layout Standard
Similarly, conditioned on 
\begin_inset Formula \begin{equation*}
s_{i-1}\neq
\sum_{x_i,\ldots,x_n\in\{0,1\}}
p(r_1,\ldots,r_{i-1},x_i,\ldots,x_n),
\end{equation*}
\end_inset

either 
\begin_inset Formula $p_i\equiv\widetilde p_i$
\end_inset

 and the verifier rejects in round 
\begin_inset Formula $i$
\end_inset

, or 
\begin_inset Formula $p_i\not\equiv\widetilde p_i$
\end_inset

 and the false claim survives the random point with probability at most 
\begin_inset Formula $d/|\mathbb{F}|$
\end_inset

. Therefore the verifier rejects in the last round except with probability 
\begin_inset Formula \begin{equation*}
\frac{nd}{|\mathbb{F}|}.
\end{equation*}
\end_inset


\end_layout

\begin_layout Subsection
Proof of 
\begin_inset Formula $\mathsf{IP}=\mathsf{PSPACE}$
\end_inset


\end_layout

\begin_layout Standard
Let 
\begin_inset Formula $\mathsf{TQBF}$
\end_inset

 be the language of true quantified Boolean formulas: 
\begin_inset Formula \begin{align*}
\mathsf{TQBF}=\{\phi:
&\text{$\phi$ is a Boolean formula and}\\
&\forall x_1\exists x_2\forall x_3\cdots\exists x_n\,
\phi(x_1,\ldots,x_n)=1\}.
\end{align*}
\end_inset


\end_layout

\begin_layout Subsection

\begin_inset Formula $\mathsf{IP}\subseteq\mathsf{PSPACE}$
\end_inset


\end_layout

\begin_layout Standard
Let 
\begin_inset Formula $(P,V)$
\end_inset

 be an interactive proof for 
\begin_inset Formula $L$
\end_inset

. For every prover 
\begin_inset Formula $A$
\end_inset

, define 
\begin_inset Formula \begin{equation*}
\alpha_A(x)=
\Pr[\langle A(x)\leftrightarrow V(x)\rangle_V=1].
\end{equation*}
\end_inset

By completeness and soundness, we can decide whether 
\begin_inset Formula $x\in L$
\end_inset

 by computing 
\begin_inset Formula \begin{equation*}
\max_A\alpha_A(x).
\end{equation*}
\end_inset

We cannot enumerate all cheating provers 
\begin_inset Formula $A$
\end_inset

 in polynomial space. Instead, we implement a prover that maximizes 
\begin_inset Formula $\alpha_A$
\end_inset

 in polynomial space by enumerating all possible transcripts recursively.
\end_layout

\begin_layout Standard
Assume without loss of generality that 
\begin_inset Formula $(P,V)$
\end_inset

 has 
\begin_inset Formula $2\ell$
\end_inset

 messages. Let 
\begin_inset Formula \begin{equation*}
V_{r,x}(p_1,\ldots,p_i)=v_{i+1}
\end{equation*}
\end_inset

be the verifier's next-message function with randomness 
\begin_inset Formula $r$
\end_inset

 and input 
\begin_inset Formula $x$
\end_inset

. Let 
\begin_inset Formula \begin{equation*}
\alpha(m_1,\ldots,m_i)
\end{equation*}
\end_inset

be the probability that the optimal prover convinces 
\begin_inset Formula $V$
\end_inset

 to accept, conditioned on the first 
\begin_inset Formula $i$
\end_inset

 messages being 
\begin_inset Formula $m_1,\ldots,m_i$
\end_inset

. Then: 
\end_layout

\begin_layout Itemize
after the last prover message, 
\begin_inset Formula $\alpha$
\end_inset

 is the conditional expectation of the verifier's acceptance predicate; 
\end_layout

\begin_layout Itemize
after a prover message, the next verifier message is averaged over the randomness 
\begin_inset Formula $r$
\end_inset

 consistent with the transcript; 
\end_layout

\begin_layout Itemize
before a prover message, 
\begin_inset Formula \begin{equation*}
\alpha(v_1,\ldots,v_i)
=\max_{p_i}\alpha(v_1,\ldots,v_i,p_i).
\end{equation*}
\end_inset


\end_layout

\begin_layout Standard
All these quantities can be computed recursively in polynomial space.
\end_layout

\begin_layout Subsection

\begin_inset Formula $\mathsf{TQBF}$
\end_inset

 Is 
\begin_inset Formula $\mathsf{PSPACE}$
\end_inset

-Complete
\end_layout

\begin_layout Theorem

\begin_inset Argument 1
status collapsed


\begin_layout Standard
Local transition formula
\end_layout

\end_inset

Let 
\begin_inset Formula $M$
\end_inset

 be a program running in time 
\begin_inset Formula $t$
\end_inset

 and space 
\begin_inset Formula $s$
\end_inset

 on inputs of size 
\begin_inset Formula $n$
\end_inset

. There exist 
\begin_inset Formula $s'=\operatorname{poly}(s)$
\end_inset

 and a 
\begin_inset Formula $\operatorname{poly}(s)$
\end_inset

-size Boolean formula 
\begin_inset Formula \begin{equation*}
\phi_{M,n}:\{0,1\}^{2s'}\longrightarrow\{0,1\}
\end{equation*}
\end_inset

such that 
\begin_inset Formula \begin{equation*}
\phi_{M,n}(C,C')=1
\end{equation*}
\end_inset

if and only if 
\begin_inset Formula $M$
\end_inset

 transitions from configuration 
\begin_inset Formula $C$
\end_inset

 to 
\begin_inset Formula $C'$
\end_inset

 in one step. 
\end_layout

\begin_layout Standard
For every 
\begin_inset Formula $x\in\{0,1\}^n$
\end_inset

, 
\begin_inset Formula $M(x)=1$
\end_inset

 if and only if there exist configurations 
\begin_inset Formula $C_1,\ldots,C_t\in\{0,1\}^{s'}$
\end_inset

 such that 
\end_layout

\begin_layout Itemize

\begin_inset Formula $C_1=x0^{s'-|x|}$
\end_inset

; 
\end_layout

\begin_layout Itemize
for every 
\begin_inset Formula $i<t$
\end_inset

, 
\begin_inset Formula $\phi_{M,n}(C_i,C_{i+1})=1$
\end_inset

; 
\end_layout

\begin_layout Itemize

\begin_inset Formula $C_t$
\end_inset

 is an accepting configuration. 
\end_layout

\begin_layout Standard

\begin_inset Formula $\mathsf{TQBF}\in\mathsf{PSPACE}$
\end_inset

 via the naive recursive algorithm. For a polynomial-space program 
\begin_inset Formula $M$
\end_inset

, construct QBFs 
\begin_inset Formula $\phi_i$
\end_inset

 such that 
\begin_inset Formula $\phi_i(C,C')$
\end_inset

 is true if and only if 
\begin_inset Formula $M$
\end_inset

 transitions from 
\begin_inset Formula $C$
\end_inset

 to 
\begin_inset Formula $C'$
\end_inset

 in 
\begin_inset Formula $2^i$
\end_inset

 steps. Set 
\begin_inset Formula \begin{equation*}
\phi_0=\phi_{M,n}.
\end{equation*}
\end_inset


\end_layout

\begin_layout Standard
The first attempted recursion is 
\begin_inset Formula \begin{equation*}
\phi_i(C,C')=
\exists D:\phi_{i-1}(C,D)\wedge\phi_{i-1}(D,C'),
\end{equation*}
\end_inset

but 
\begin_inset Formula $\phi_i$
\end_inset

 is exponential in 
\begin_inset Formula $i$
\end_inset

. Instead use 
\begin_inset Formula \begin{multline*}
\phi_i(C,C')=
\exists D\,\forall E,E':\\
\bigl((E,E')=(C,D)\vee(E,E')=(D,C')\bigr)
\longrightarrow\phi_{i-1}(E,E').
\end{multline*}
\end_inset


\end_layout

\begin_layout Subsection
Interactive Proof for 
\begin_inset Formula $\mathsf{TQBF}$
\end_inset


\end_layout

\begin_layout Standard
First arithmetize 
\begin_inset Formula $\mathsf{TQBF}$
\end_inset

 and then use a variant of sum check. Given a formula 
\begin_inset Formula $\phi$
\end_inset

 with 
\begin_inset Formula $n$
\end_inset

 variables, compute a polynomial 
\begin_inset Formula \begin{equation*}
p\in\mathbb{F}[x_1,\ldots,x_n]
\end{equation*}
\end_inset

of degree at most 
\begin_inset Formula $|\phi|$
\end_inset

 such that 
\begin_inset Formula \begin{equation*}
A_{x_1}E_{x_2}A_{x_3}\cdots E_{x_n}p(x_1,\ldots,x_n)
=
\forall x_1\exists x_2\forall x_3\cdots\exists x_n
\phi(x_1,\ldots,x_n),
\end{equation*}
\end_inset

where 
\begin_inset Formula \begin{align*}
A_yq(y,x_1,\ldots,x_m)
&=q(0,x_1,\ldots,x_m)q(1,x_1,\ldots,x_m),\\
E_yq(y,x_1,\ldots,x_m)
&=1-(1-q(0,x_1,\ldots,x_m))(1-q(1,x_1,\ldots,x_m)).
\end{align*}
\end_inset


\end_layout

\begin_layout Subsubsection
The Degree Problem
\end_layout

\begin_layout Standard
The goal is to eliminate quantifiers one by one. The direct univariate polynomial 
\begin_inset Formula \begin{equation*}
p_1(y)=E_{x_2}A_{x_3}\cdots E_{x_n}p(y,x_2,\ldots,x_n)
\end{equation*}
\end_inset

has high degree. The solution uses the fact that 
\begin_inset Formula $x^d$
\end_inset

 and 
\begin_inset Formula $x$
\end_inset

 agree on 
\begin_inset Formula $\{0,1\}$
\end_inset

.
\end_layout

\begin_layout Definition

\begin_inset Argument 1
status collapsed


\begin_layout Standard
Degree-reduction operator
\end_layout

\end_inset


\begin_inset CommandInset label
LatexCommand label
name "def:degree-reduction"

\end_inset

 Define 
\begin_inset Formula \begin{equation*}
R_yq(y,x_1,\ldots,x_m)
=(1-y)q(0,x_1,\ldots,x_m)+yq(1,x_1,\ldots,x_m).
\end{equation*}
\end_inset

The polynomial 
\begin_inset Formula $R_yq$
\end_inset

 has degree one in 
\begin_inset Formula $y$
\end_inset

 and agrees with 
\begin_inset Formula $q$
\end_inset

 on Boolean inputs. 
\end_layout

\begin_layout Standard
It is sufficient to prove 
\begin_inset Formula \begin{multline*}
A_{x_1}R_{x_1}E_{x_2}R_{x_1}R_{x_2}A_{x_3}
R_{x_1}R_{x_2}R_{x_3}\cdots\\
E_{x_n}R_{x_1}R_{x_2}\cdots R_{x_n}p(x_1,\ldots,x_n)=1.
\end{multline*}
\end_inset


\end_layout

\begin_layout Standard
There are 
\begin_inset Formula \begin{equation*}
m=O(n^2)
\end{equation*}
\end_inset

operators. The protocol eliminates one operator per round and eliminates 
\begin_inset Formula $A,E$
\end_inset

 operators as in sum check.
\end_layout

\begin_layout Subsubsection
Eliminating Degree-Reduction Operators
\end_layout

\begin_layout Standard
Before round 
\begin_inset Formula $k$
\end_inset

, we need to prove a statement of the form 
\begin_inset Formula \begin{equation*}
R_{x_i}Q_{k+1}\cdots Q_m
p(r_1,\ldots,r_j,x_{j+1},\ldots,x_n)=s_{k-1}
\end{equation*}
\end_inset

for some 
\begin_inset Formula $i\leq j$
\end_inset

. The prover computes a univariate polynomial 
\begin_inset Formula $p_k$
\end_inset

 of degree at most 
\begin_inset Formula $\max\{d,2\}$
\end_inset

: 
\begin_inset Formula \begin{equation*}
p_k(y)=Q_{k+1}\cdots Q_m
p(r_1,\ldots,r_{i-1},y,r_{i+1},\ldots,r_j,
x_{j+1},\ldots,x_n).
\end{equation*}
\end_inset

The prover sends 
\begin_inset Formula $p_k$
\end_inset

 to the verifier. The verifier checks 
\begin_inset Formula \begin{equation*}
R_yp_k(r_i)=s_{k-1},
\end{equation*}
\end_inset

samples a new 
\begin_inset Formula $r_i\xleftarrow{R}\mathbb{F}$
\end_inset

, sets 
\begin_inset Formula \begin{equation*}
s_k=p_k(r_i),
\end{equation*}
\end_inset

and sends 
\begin_inset Formula $r_i$
\end_inset

 to the prover.
\end_layout

