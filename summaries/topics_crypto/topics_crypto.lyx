\end_inset

, and 
\begin_inset Formula $a_3=P(3)$
\end_inset

, recover the coefficients from 
\begin_inset Formula \begin{equation*}
\begin{cases}
p_2 1^2+p_1 1+p_0=a_1,\\
p_2 2^2+p_1 2+p_0=a_2,\\
p_2 3^2+p_1 3+p_0=a_3.
\end{cases}
\end{equation*}
\end_inset

The coefficient matrix is a Vandermonde matrix and is invertible because 
\begin_inset Formula $1,2,3$
\end_inset

 are distinct in 
\begin_inset Formula $\mathbb{F}$
\end_inset

.
\end_layout

\begin_layout Subsubsection
Reducing a Server Using Partial Derivatives
\end_layout

\begin_layout Standard
Retain the queries 
\begin_inset Formula $q_1=v_i+r$
\end_inset

 and 
\begin_inset Formula $q_2=v_i+2r$
\end_inset

. In addition to 
\begin_inset Formula $P(1)$
\end_inset

 and 
\begin_inset Formula $P(2)$
\end_inset

, server 1 returns all first partial derivatives of 
\begin_inset Formula $f_x$
\end_inset

 at 
\begin_inset Formula $q_1$
\end_inset

. The chain rule gives 
\begin_inset Formula \begin{equation*}
P'(t)
=\sum_{j=1}^m r_j
\frac{\partial f_x}{\partial z_j}(v_i+tr).
\end{equation*}
\end_inset

Thus the decoder obtains 
\begin_inset Formula $P'(1)$
\end_inset

. The data 
\begin_inset Formula $P(1),P'(1),P(2)$
\end_inset

 uniquely determine a polynomial of degree at most two, and therefore determine 
\begin_inset Formula $P(0)=x[i]$
\end_inset

. The two query distributions remain uniform.
\end_layout

\begin_layout Subsubsection
Four-Server RM-PIR and Reduction to Two Servers
\end_layout

\begin_layout Theorem

\begin_inset Argument 1
status collapsed


\begin_layout Standard
HW 2, Exercise 4
\end_layout

\end_inset

Over a field of characteristic greater than three, a degree-three generalization of RM-PIR gives a perfectly 1-private four-server PIR with communication 
\begin_inset Formula $O(N^{1/3})$
\end_inset

, and partial derivatives reduce it to two servers with the same asymptotic communication. 
\end_layout

\begin_layout Proof
Let 
\begin_inset Formula $m=O(N^{1/3})$
\end_inset

, let 
\begin_inset Formula $f_x:\mathbb{F}^m\to\mathbb{F}$
\end_inset

 have total degree at most three, and let designated points 
\begin_inset Formula $v_i$
\end_inset

 satisfy 
\begin_inset Formula $f_x(v_i)=x[i]$
\end_inset

. For a requested index 
\begin_inset Formula $i$
\end_inset

, choose uniform 
\begin_inset Formula $r\in\mathbb{F}^m$
\end_inset

 and define 
\begin_inset Formula \begin{equation*}
q_\ell=v_i+\ell r,
\qquad \ell\in\{1,2,3,4\}.
\end{equation*}
\end_inset

For 
\begin_inset Formula $P(t)=f_x(v_i+tr)$
\end_inset

, the four answers are 
\begin_inset Formula $P(1),P(2),P(3),P(4)$
\end_inset

. Interpolation recovers 
\begin_inset Formula $P(0)=x[i]$
\end_inset

. Every query is uniform.
\end_layout

\begin_layout Proof
To retain only servers 1 and 2, each returns 
\begin_inset Formula $P(\ell)$
\end_inset

 and all first partial derivatives at 
\begin_inset Formula $q_\ell$
\end_inset

. The client computes 
\begin_inset Formula \begin{equation*}
P'(\ell)=\sum_{j=1}^m r_j
\frac{\partial f_x}{\partial z_j}(q_\ell).
\end{equation*}
\end_inset

The Hermite data 
\begin_inset Formula $P(1),P'(1),P(2),P'(2)$
\end_inset

 uniquely determine a polynomial of degree at most three. Each retained server sends 
\begin_inset Formula $m+1$
\end_inset

 field elements, so the communication remains 
\begin_inset Formula $O(N^{1/3})$
\end_inset

. 
\end_layout

\begin_layout Subsection
Matching Vectors
\end_layout

\begin_layout Subsubsection
Hadamard as an Inner-Product Construction
\end_layout

\begin_layout Standard
In the Hadamard protocol, 
\begin_inset Formula \begin{equation*}
a_s=\left\langle\sum_{j=1}^N x[j]e_j,q_s\right\rangle
\end{equation*}
\end_inset

and 
\begin_inset Formula $q_2-q_1=e_i$
\end_inset

. Therefore 
\begin_inset Formula \begin{equation*}
a_2-a_1
=\sum_{j=1}^N x[j]\langle e_j,e_i\rangle
=x[i].
\end{equation*}
\end_inset

Matching-vector constructions replace the standard basis vectors by vectors of dimension 
\begin_inset Formula $h\ll N$
\end_inset

.
\end_layout

\begin_layout Subsubsection
A Conditional Two-Server Cancellation Construction
\end_layout

\begin_layout Definition

\begin_inset Argument 1
status collapsed


\begin_layout Standard
Cancellation matching-vector family
\end_layout

\end_inset


\begin_inset CommandInset label
LatexCommand label
name "def:cancellation-mv-family"

\end_inset

 A cancellation matching-vector family of size 
\begin_inset Formula $N$
\end_inset

 and dimension 
\begin_inset Formula $h$
\end_inset

 is a pair of indexed families 
\begin_inset Formula \begin{equation*}
U=(u_1,\ldots,u_N),
\qquad
V=(v_1,\ldots,v_N)
\end{equation*}
\end_inset

in 
\begin_inset Formula $\mathbb{Z}_6^h$
\end_inset

 satisfying 
\begin_inset Formula \begin{equation*}
\langle u_i,v_j\rangle_6=
\begin{cases}
1, & i=j,\\
2,3,\text{ or }4, & i\neq j.
\end{cases}
\end{equation*}
\end_inset

Thus every off-diagonal inner product vanishes modulo 
\begin_inset Formula $2$
\end_inset

 or modulo 
\begin_inset Formula $3$
\end_inset

, whereas every diagonal inner product equals one in both fields. 
\end_layout

\begin_layout Standard
For 
\begin_inset Formula $w\in\mathbb{Z}_6^h$
\end_inset

, write 
\begin_inset Formula $w^{(2)}$
\end_inset

 and 
\begin_inset Formula $w^{(3)}$
\end_inset

 for its coordinate-wise reductions modulo 
\begin_inset Formula $2$
\end_inset

 and modulo 
\begin_inset Formula $3$
\end_inset

, respectively. The query algorithm samples 
\begin_inset Formula $r\xleftarrow{R}\mathbb{Z}_2^h$
\end_inset

 and defines 
\begin_inset Formula \begin{equation*}
q_1=r,
\qquad
q_2=r+u_i^{(2)}.
\end{equation*}
\end_inset

For 
\begin_inset Formula $s\in\{1,2\}$
\end_inset

, define the answer map by 
\begin_inset Formula \begin{equation*}
a_s
=\sum_{j=1}^N
x[j]\langle v_j^{(2)},q_s\rangle_2v_j^{(3)}
\in\mathbb{Z}_3^h.
\end{equation*}
\end_inset

The decoder computes 
\begin_inset Formula \begin{equation*}
z=\langle u_i^{(3)},a_2-a_1\rangle_3.
\end{equation*}
\end_inset

Its output bit is 
\begin_inset Formula $1$
\end_inset

 if 
\begin_inset Formula $z\neq0$
\end_inset

 and 
\begin_inset Formula $0$
\end_inset

 otherwise.
\end_layout

\begin_layout Lemma

\begin_inset Argument 1
status collapsed


\begin_layout Standard
Cancellation identity
\end_layout

\end_inset


\begin_inset CommandInset label
LatexCommand label
name "lem:mv-cancellation"

\end_inset

 For 
\begin_inset Formula $i,j\in[N]$
\end_inset

 and 
\begin_inset Formula $r\in\mathbb{Z}_2^h$
\end_inset

, define 
\begin_inset Formula \begin{align*}
\eta_{i,j}(r)
&=\langle u_i,v_j\rangle_3\,d_{i,j}(r),\\
d_{i,j}(r)
&=\langle v_j^{(2)},r+u_i^{(2)}\rangle_2
-\langle v_j^{(2)},r\rangle_2,
\end{align*}
\end_inset

where the two values in 
\begin_inset Formula $\mathbb{Z}_2$
\end_inset

 are represented by 
\begin_inset Formula $0$
\end_inset

 and 
\begin_inset Formula $1$
\end_inset

 before subtraction and the result is reduced modulo 
\begin_inset Formula $3$
\end_inset

. Then 
\begin_inset Formula \begin{equation*}
\eta_{i,j}(r)\in
\begin{cases}
\{1,-1\}, & i=j,\\
\{0\}, & i\neq j
\end{cases}.
\end{equation*}
\end_inset


\end_layout

\begin_layout Proof
For 
\begin_inset Formula $i=j$
\end_inset

, adding 
\begin_inset Formula $u_i^{(2)}$
\end_inset

 toggles the bit 
\begin_inset Formula $\langle v_i^{(2)},r\rangle_2$
\end_inset

, while 
\begin_inset Formula $\langle u_i,v_i\rangle_3=1$
\end_inset

. The difference of the two bit representatives is therefore 
\begin_inset Formula $1$
\end_inset

 or 
\begin_inset Formula $-1$
\end_inset

. For 
\begin_inset Formula $i\neq j$
\end_inset

, the inner product lies in 
\begin_inset Formula $\{2,3,4\}$
\end_inset

. If it is 
\begin_inset Formula $2$
\end_inset

 or 
\begin_inset Formula $4$
\end_inset

, then 
\begin_inset Formula $\langle u_i^{(2)},v_j^{(2)}\rangle_2=0$
\end_inset

, so the two bit values are equal. If it is 
\begin_inset Formula $3$
\end_inset

, then 
\begin_inset Formula $\langle u_i,v_j\rangle_3=0$
\end_inset

. In either case the product is zero modulo 
\begin_inset Formula $3$
\end_inset

. 
\end_layout

\begin_layout Theorem

\begin_inset Argument 1
status collapsed


\begin_layout Standard
Two-server cancellation protocol
\end_layout

\end_inset


\begin_inset CommandInset label
LatexCommand label
name "thm:matching-vector-correctness"

\end_inset

 Given a cancellation matching-vector family as in Definition
\begin_inset space ~

\end_inset


\begin_inset CommandInset ref
LatexCommand ref
reference "def:cancellation-mv-family"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset

, the maps defined above form a perfectly correct, perfectly 1-private two-server PIR with query and answer lengths 
\begin_inset Formula $O(h)$
\end_inset

. 
\end_layout

\begin_layout Proof
Expanding the decoder value and applying Lemma
\begin_inset space ~

\end_inset


\begin_inset CommandInset ref
LatexCommand ref
reference "lem:mv-cancellation"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset

 gives 
\begin_inset Formula \begin{equation*}
z=\sum_{j=1}^N x[j]\eta_{i,j}(r)
=x[i]\eta_{i,i}(r).
\end{equation*}
\end_inset

Because 
\begin_inset Formula $\eta_{i,i}(r)$
\end_inset

 is nonzero in 
\begin_inset Formula $\mathbb{Z}_3$
\end_inset

, one has 
\begin_inset Formula $z\neq0$
\end_inset

 if and only if 
\begin_inset Formula $x[i]=1$
\end_inset

. Thus the decoder outputs 
\begin_inset Formula $x[i]$
\end_inset

. The query 
\begin_inset Formula $q_1$
\end_inset

 is uniform in 
\begin_inset Formula $\mathbb{Z}_2^h$
\end_inset

, and 
\begin_inset Formula $q_2$
\end_inset

 is its translation by the fixed vector 
\begin_inset Formula $u_i^{(2)}$
\end_inset

; hence each individual query is uniform and independent of 
\begin_inset Formula $i$
\end_inset

. 
\end_layout

\begin_layout Subsubsection
Standard Matching-Vector Families
\end_layout

\begin_layout Definition

\begin_inset Argument 1
status collapsed


\begin_layout Standard
Matching-vector family over 
\begin_inset Formula $\mathbb{Z}_6$
\end_inset


\end_layout

\end_inset


\begin_inset CommandInset label
LatexCommand label
name "def:matching-vector-family"

\end_inset

 A matching-vector family of size 
\begin_inset Formula $N$
\end_inset

 and dimension 
\begin_inset Formula $h$
\end_inset

 is a pair 
\begin_inset Formula \begin{equation*}
U=(u_1,\ldots,u_N),
\qquad
V=(v_1,\ldots,v_N)
\end{equation*}
\end_inset

in 
\begin_inset Formula $\mathbb{Z}_6^h$
\end_inset

 such that 
\begin_inset Formula \begin{equation*}
\langle u_i,v_j\rangle_6=
\begin{cases}
0, & i=j,\\
1,3,\text{ or }4, & i\neq j.
\end{cases}
\end{equation*}
\end_inset


\end_layout

\begin_layout Theorem

\begin_inset Argument 1
status collapsed


\begin_layout Standard
HW 2, Exercise 5
\end_layout

\end_inset


\begin_inset CommandInset label
LatexCommand label
name "thm:mv-family-construction"

\end_inset

 Assume that a polynomial 
\begin_inset Formula $P(x_1,\ldots,x_n)$
\end_inset

 over 
\begin_inset Formula $\mathbb{Z}_6$
\end_inset

 has total degree 
\begin_inset Formula $d=O(\sqrt n)$
\end_inset

 and satisfies 
\begin_inset Formula \begin{equation*}
P(0,\ldots,0)=0,
\qquad
P(x)\in\{1,3,4\}
\quad\text{for every }x\in\{0,1\}^n\setminus\{0^n\}.
\end{equation*}
\end_inset

Then there is a matching-vector family of size 
\begin_inset Formula $N=2^n$
\end_inset

 and dimension 
\begin_inset Formula \begin{equation*}
h=\binom{n+d}{d}
=n^{O(\sqrt n)}
=\exp\bigl(O(\sqrt{\log N\log\log N})\bigr).
\end{equation*}
\end_inset


\end_layout

\begin_layout Proof
For 
\begin_inset Formula $b_i,x_i\in\{0,1\}$
\end_inset

, define the affine polynomial 
\begin_inset Formula \begin{equation*}
\delta_{b_i}(x_i)=
\begin{cases}
x_i, & b_i=0,\\
1-x_i, & b_i=1.
\end{cases}
\end{equation*}
\end_inset

For every 
\begin_inset Formula $b\in\{0,1\}^n$
\end_inset

, define 
\begin_inset Formula \begin{equation*}
g_b(x_1,\ldots,x_n)
=P\bigl(\delta_{b_1}(x_1),\ldots,\delta_{b_n}(x_n)\bigr).
\end{equation*}
\end_inset

For 
\begin_inset Formula $a,b\in\{0,1\}^n$
\end_inset

, the input to 
\begin_inset Formula $P$
\end_inset

 is 
\begin_inset Formula $0^n$
\end_inset

 exactly when 
\begin_inset Formula $a=b$
\end_inset

. Moreover, 
\begin_inset Formula $g_b$
\end_inset

 has degree at most 
\begin_inset Formula $d$
\end_inset

 because every 
\begin_inset Formula $\delta_{b_i}$
\end_inset

 is affine. Consequently, 
\begin_inset Formula \begin{equation*}
g_b(a)=
\begin{cases}
0, & a=b,\\
1,3,\text{ or }4, & a\neq b
\end{cases}
\pmod6.
\end{equation*}
\end_inset


\end_layout

\begin_layout Proof
List all monomials of total degree at most 
\begin_inset Formula $d$
\end_inset

 as 
\begin_inset Formula $M_1,\ldots,M_h$
\end_inset

, and write 
\begin_inset Formula \begin{equation*}
g_b(x)=\sum_{\ell=1}^h c_{b,\ell}M_\ell(x).
\end{equation*}
\end_inset

Define 
\begin_inset Formula \begin{equation*}
u_a=(M_1(a),\ldots,M_h(a)),
\qquad
v_b=(c_{b,1},\ldots,c_{b,h}).
\end{equation*}
\end_inset

Then 
\begin_inset Formula $\langle u_a,v_b\rangle_6=g_b(a)$
\end_inset

, so Definition
\begin_inset space ~

\end_inset


\begin_inset CommandInset ref
LatexCommand ref
reference "def:matching-vector-family"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset

 is satisfied. The dimension is the number of monomials of total degree at most 
\begin_inset Formula $d$
\end_inset

. 
\end_layout

\begin_layout Subsubsection
Four-Server PIR from a Standard Matching-Vector Family
\end_layout

\begin_layout Lemma

\begin_inset Argument 1
status collapsed


\begin_layout Standard
Embedding into 
\begin_inset Formula $\mathbb{F}_7^*$
\end_inset


\end_layout

\end_inset


\begin_inset CommandInset label
LatexCommand label
name "lem:z6-f7-embedding"

\end_inset

 The map 
\begin_inset Formula \begin{equation*}
\varphi:\mathbb{Z}_6\longrightarrow\mathbb{F}_7^*,
\qquad
\varphi(y)=3^y\pmod7,
\end{equation*}
\end_inset

is a group isomorphism. 
\end_layout

\begin_layout Proof
The element 
\begin_inset Formula $3\in\mathbb{F}_7^*$
\end_inset

 has order six, since 
\begin_inset Formula \begin{equation*}
3^0,3^1,3^2,3^3,3^4,3^5
\equiv1,3,2,6,4,5\pmod7.
\end{equation*}
\end_inset

Thus 
\begin_inset Formula $\varphi$
\end_inset

 is a bijective homomorphism between cyclic groups of order six. 
\end_layout

\begin_layout Standard
Fix a matching-vector family as in Definition
\begin_inset space ~

\end_inset


\begin_inset CommandInset ref
LatexCommand ref
reference "def:matching-vector-family"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset

 and define 
\begin_inset Formula \begin{equation*}
f_x(z)=\sum_{j=1}^N x[j]3^{\langle v_j,z\rangle_6}
\in\mathbb{F}_7.
\end{equation*}
\end_inset

For a requested index 
\begin_inset Formula $i$
\end_inset

, the query algorithm samples 
\begin_inset Formula $r\xleftarrow{R}\mathbb{Z}_6^h$
\end_inset

 and, for 
\begin_inset Formula $t\in\{0,1,2,3\}$
\end_inset

, defines 
\begin_inset Formula \begin{equation*}
q_t=r+tu_i
\end{equation*}
\end_inset

The answer map is 
\begin_inset Formula $A_t(x,q_t)=f_x(q_t)$
\end_inset

. Define 
\begin_inset Formula \begin{equation*}
P(t)=f_x(r+tu_i).
\end{equation*}
\end_inset

For 
\begin_inset Formula $\ell\in\{0,1,3,4\}$
\end_inset

, let 
\begin_inset Formula \begin{equation*}
c_\ell
=\sum_{\substack{j\in[N]\\
\langle v_j,u_i\rangle_6=\ell}}
x[j]3^{\langle v_j,r\rangle_6}.
\end{equation*}
\end_inset

Then 
\begin_inset Formula \begin{equation*}
P(t)=c_0+3^tc_1+3^{3t}c_3+3^{4t}c_4,
\end{equation*}
\end_inset

and the matching property implies 
\begin_inset Formula \begin{equation*}
c_0=x[i]3^{\langle v_i,r\rangle_6}.
\end{equation*}
\end_inset


\end_layout

\begin_layout Theorem

\begin_inset Argument 1
status collapsed


\begin_layout Standard
Four-server matching-vector PIR
\end_layout

\end_inset


\begin_inset CommandInset label
LatexCommand label
name "thm:four-server-mv-pir"

\end_inset

 The maps defined above form a perfectly correct, perfectly 1-private four-server PIR with query length 
\begin_inset Formula $O(h)$
\end_inset

 and 
\begin_inset Formula $O(1)$
\end_inset

-bit answers. 
\end_layout

\begin_layout Proof
The four answers 
\begin_inset Formula $P(0),P(1),P(2),P(3)$
\end_inset

 form a linear system in 
\begin_inset Formula $(c_0,c_1,c_3,c_4)$
\end_inset

 with coefficient matrix 
\begin_inset Formula \begin{equation*}
\begin{pmatrix}
1&1&1&1\\
1&3&6&4\\
1&2&1&2\\
1&6&6&1
\end{pmatrix}
\in\mathbb{F}_7^{4\times4}.
\end{equation*}
\end_inset

Its determinant is 
\begin_inset Formula $2\pmod7$
\end_inset

, so the system is invertible. After recovering 
\begin_inset Formula $c_0$
\end_inset

, divide by the known nonzero value 
\begin_inset Formula $3^{\langle v_i,r\rangle_6}$
\end_inset

 to obtain 
\begin_inset Formula $x[i]$
\end_inset

.
\end_layout

\begin_layout Proof
For every fixed 
\begin_inset Formula $t$
\end_inset

, the query 
\begin_inset Formula $q_t$
\end_inset

 is uniform in 
\begin_inset Formula $\mathbb{Z}_6^h$
\end_inset

 because it is a translation of the uniform vector 
\begin_inset Formula $r$
\end_inset

. Hence each server's query is independent of 
\begin_inset Formula $i$
\end_inset

. 
\end_layout

\begin_layout Subsubsection
Further Optimizations
\end_layout

\begin_layout Standard
The three-server refinement has query length 
\begin_inset Formula \begin{equation*}
O(h)=N^{O(\log\log N/\log N)}
\end{equation*}
\end_inset

and 
\begin_inset Formula $O(1)$
\end_inset

-bit answers. Balancing the query and answer lengths gives total communication 
\begin_inset Formula \begin{equation*}
N^{O\left((\log\log N/\log N)^{2/3}\right)}.
\end{equation*}
\end_inset

With 
\begin_inset Formula $O(1)$
\end_inset

-bit answers, the analogous two-server improvement is impossible.
\end_layout

\begin_layout Subsection
From IT-PIR to Locally Decodable Codes
\end_layout

\begin_layout Definition

\begin_inset Argument 1
status collapsed


\begin_layout Standard
Locally decodable code
\end_layout

\end_inset


\begin_inset CommandInset label
LatexCommand label
name "def:ldc"

\end_inset

 Let 
\begin_inset Formula $\Sigma$
\end_inset

 be a finite alphabet. A 
\begin_inset Formula $(k,\delta,p)$
\end_inset

-locally decodable code is a map 
\begin_inset Formula \begin{equation*}
C:\{0,1\}^N\longrightarrow\Sigma^M
\end{equation*}
\end_inset

with a randomized decoder 
\begin_inset Formula $\mathcal{D}$
\end_inset

 that makes at most 
\begin_inset Formula $k$
\end_inset

 queries to its oracle word and satisfies the following condition: for every 
\begin_inset Formula $x\in\{0,1\}^N$
\end_inset

, every 
\begin_inset Formula $i\in[N]$
\end_inset

, and every 
\begin_inset Formula $y\in\Sigma^M$
\end_inset

 such that 
\begin_inset Formula \begin{equation*}
\bigl|\{j\in[M]:y[j]\neq C(x)[j]\}\bigr|\leq\delta M,
\end{equation*}
\end_inset

one has 
\begin_inset Formula \begin{equation*}
\Pr[\mathcal{D}^{y}(i)=x[i]]\geq p,
\end{equation*}
\end_inset

where the probability is over the randomness of 
\begin_inset Formula $\mathcal{D}$
\end_inset

. 
\end_layout

\begin_layout Theorem

\begin_inset Argument 1
status collapsed


\begin_layout Standard
PIR-to-LDC correspondence, Katz–Trevisan 00
\end_layout

\end_inset


\begin_inset CommandInset label
LatexCommand label
name "thm:pir-to-ldc"

\end_inset

 Let 
\begin_inset Formula $\Pi$
\end_inset

 be a perfectly correct 
\begin_inset Formula $k$
\end_inset

-server PIR in which every query belongs to 
\begin_inset Formula $\{0,1\}^{\alpha}$
\end_inset

, every answer belongs to 
\begin_inset Formula $\Sigma=\{0,1\}^{\beta}$
\end_inset

, and 
\begin_inset Formula $Q_s(i,R)$
\end_inset

 is uniform over 
\begin_inset Formula $\{0,1\}^{\alpha}$
\end_inset

 for every 
\begin_inset Formula $s\in[k]$
\end_inset

 and 
\begin_inset Formula $i\in[N]$
\end_inset

. Then 
\begin_inset Formula $\Pi$
\end_inset

 defines a 
\begin_inset Formula $(k,\delta,1-k\delta)$
\end_inset

-locally decodable code of length 
\begin_inset Formula \begin{equation*}
M=k2^{\alpha}
\end{equation*}
\end_inset

over 
\begin_inset Formula $\Sigma$
\end_inset

. 
\end_layout

\begin_layout Proof
Index the codeword coordinates by pairs 
\begin_inset Formula $(s,q)\in[k]\times\{0,1\}^{\alpha}$
\end_inset

 and define 
\begin_inset Formula \begin{equation*}
C(x)[s,q]=A_s(x,q).
\end{equation*}
\end_inset

The local decoder samples 
\begin_inset Formula $r\xleftarrow{R}\mathcal{R}$
\end_inset

 and computes 
\begin_inset Formula \begin{equation*}
(q_1,\ldots,q_k)=Q(i,r).
\end{equation*}
\end_inset

It reads the coordinates 
\begin_inset Formula $(s,q_s)$
\end_inset

 for 
\begin_inset Formula $s\in[k]$
\end_inset

 and applies the PIR decoding map to the resulting 
\begin_inset Formula $k$
\end_inset

 symbols.
\end_layout

\begin_layout Proof
Let 
\begin_inset Formula $B_s\subseteq\{0,1\}^{\alpha}$
\end_inset

 be the set of corrupted coordinates in the block belonging to server 
\begin_inset Formula $s$
\end_inset

. Uniformity gives 
\begin_inset Formula \begin{equation*}
\Pr[q_s\in B_s]=\frac{|B_s|}{2^{\alpha}}.
\end{equation*}
\end_inset

If at most a 
\begin_inset Formula $\delta$
\end_inset

 fraction of the 
\begin_inset Formula $M$
\end_inset

 coordinates are corrupted, then 
\begin_inset Formula \begin{equation*}
\sum_{s=1}^k|B_s|\leq\delta k2^{\alpha}.
\end{equation*}
\end_inset

The union bound therefore gives 
\begin_inset Formula \begin{equation*}
\Pr[\exists s:q_s\in B_s]
\leq\sum_{s=1}^k\frac{|B_s|}{2^{\alpha}}
\leq k\delta.
\end{equation*}
\end_inset

Conditioned on querying no corrupted coordinate, perfect PIR correctness implies that the decoder outputs 
\begin_inset Formula $x[i]$
\end_inset

. 
\end_layout

\begin_layout Standard
The reverse implication requires the local decoder's query distribution to satisfy the corresponding smoothness condition. 
\begin_inset Newpage newpage
\end_inset


\end_layout

