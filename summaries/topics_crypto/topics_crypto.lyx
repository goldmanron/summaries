\begin_layout Subsubsection
Concatenation with Independent Randomness
\end_layout

\begin_layout Theorem

\begin_inset Argument 1
status collapsed


\begin_layout Standard
HW 3, Exercise 5
\end_layout

\end_inset

Let 
\begin_inset Formula $f_1,f_2:X\to Y$
\end_inset

, and suppose 
\begin_inset Formula \begin{equation*}
g_1:X\times R_1\to Z_1,
\qquad
g_2:X\times R_2\to Z_2
\end{equation*}
\end_inset

encode 
\begin_inset Formula $f_1$
\end_inset

 and 
\begin_inset Formula $f_2$
\end_inset

, respectively. Then 
\begin_inset Formula \begin{equation*}
g(x;(r_1,r_2))
=\bigl(g_1(x;r_1),g_2(x;r_2)\bigr)
\end{equation*}
\end_inset

with independent 
\begin_inset Formula $r_1,r_2$
\end_inset

 encodes 
\begin_inset Formula \begin{equation*}
f(x)=\bigl(f_1(x),f_2(x)\bigr).
\end{equation*}
\end_inset


\end_layout

\begin_layout Proof
Let 
\begin_inset Formula $(S_1,D_1)$
\end_inset

 and 
\begin_inset Formula $(S_2,D_2)$
\end_inset

 be simulators and decoders for the two encodings. Define 
\begin_inset Formula \begin{align*}
D(z_1,z_2)&=(D_1(z_1),D_2(z_2)),\\
S(y_1,y_2)&=(S_1(y_1),S_2(y_2)),
\end{align*}
\end_inset

where the two simulations use independent randomness.
\end_layout

\begin_layout Proof
Correctness follows from 
\begin_inset Formula \begin{align*}
D(g(x;(r_1,r_2)))
&=\bigl(D_1(g_1(x;r_1)),D_2(g_2(x;r_2))\bigr)\\
&=\bigl(f_1(x),f_2(x)\bigr)=f(x).
\end{align*}
\end_inset

For independent uniform 
\begin_inset Formula $r_1,r_2$
\end_inset

, 
\begin_inset Formula \begin{align*}
g(x;(r_1,r_2))
&=\bigl(g_1(x;r_1),g_2(x;r_2)\bigr)\\
&\equiv\bigl(S_1(f_1(x)),S_2(f_2(x))\bigr)
=S(f(x)).
\end{align*}
\end_inset


\end_layout

\begin_layout Claim

\begin_inset Argument 1
status collapsed


\begin_layout Standard
Reusing randomness can destroy privacy
\end_layout

\end_inset

If 
\begin_inset Formula $R_1=R_2$
\end_inset

 and 
\begin_inset Formula \begin{equation*}
g'(x;r)=\bigl(g_1(x;r),g_2(x;r)\bigr),
\end{equation*}
\end_inset

then 
\begin_inset Formula $g'$
\end_inset

 need not encode 
\begin_inset Formula $(f_1,f_2)$
\end_inset

. 
\end_layout

\begin_layout Proof
Let 
\begin_inset Formula $X=R_1=R_2=\{0,1\}$
\end_inset

 and let 
\begin_inset Formula \begin{equation*}
f_1(x)=f_2(x)=0.
\end{equation*}
\end_inset

Define 
\begin_inset Formula \begin{equation*}
g_1(x;r)=r,
\qquad
g_2(x;r)=x+r,
\end{equation*}
\end_inset

with addition over 
\begin_inset Formula $\mathbb{F}_2$
\end_inset

. Each encoding is individually correct with the constant decoder 
\begin_inset Formula $D(z)=0$
\end_inset

, and each is private because its output is uniform. However, 
\begin_inset Formula \begin{equation*}
g'(x;r)=(r,x+r).
\end{equation*}
\end_inset

For 
\begin_inset Formula $x=0$
\end_inset

 this is 
\begin_inset Formula $(r,r)$
\end_inset

, while for 
\begin_inset Formula $x=1$
\end_inset

 it is 
\begin_inset Formula $(r,1-r)$
\end_inset

. Since 
\begin_inset Formula $f(0)=f(1)=(0,0)$
\end_inset

, a simulator receiving only 
\begin_inset Formula $f(x)$
\end_inset

 would have to produce both distinct distributions, which is impossible. 
\end_layout

\begin_layout Subsection
PSM Complexity Bounds
\end_layout

\begin_layout Theorem
Every 
\begin_inset Formula \begin{equation*}
f:\{0,1\}^n\times\{0,1\}^n\longrightarrow\{0,1\}
\end{equation*}
\end_inset

has a two-party PSM of complexity 
\begin_inset Formula $O(2^{n/2})$
\end_inset

. 
\end_layout

\begin_layout Subsection
Yao's Garbled-Circuit Construction
\end_layout

\begin_layout Standard
Each wire 
\begin_inset Formula $w$
\end_inset

 has a 
\begin_inset Formula $0$
\end_inset

-key and a 
\begin_inset Formula $1$
\end_inset

-key, colored blue and green at random. The online encoding of input bit 
\begin_inset Formula $x_i$
\end_inset

 is the key 
\begin_inset Formula $K_{i,x_i}$
\end_inset

. The offline part 
\begin_inset Formula $g_0(r)$
\end_inset

 contains the color code for output wires and the garbled gates. The decoder evaluates the garbled circuit, while the simulator generates a view from the circuit output alone.
\end_layout

\begin_layout Standard
For a gate with input-wire keys 
\begin_inset Formula $a,b$
\end_inset

 and output key 
\begin_inset Formula $c$
\end_inset

, use nested one-time pads 
\begin_inset Formula $E_a(E_b(c))$
\end_inset

.
\end_layout

\begin_layout Theorem

\begin_inset Argument 1
status collapsed


\begin_layout Standard
Security of formula garbling
\end_layout

\end_inset

For a Boolean formula, nested one-time-pad garbling is a perfect randomized encoding of the formula output. 
\end_layout

\begin_layout Proof
Correctness is maintained by the wire-label invariant: the decoder holds exactly one label for each evaluated wire, and the garbled gate maps the two input labels to the label representing the correct output bit. For privacy, the simulator chooses random labels only along the evaluated path and fills all unevaluated ciphertext entries with uniform strings. With one-time pads, these strings have exactly the real distribution. Formula fan-out prevents a label from being reused across independent branches. 
\end_layout

