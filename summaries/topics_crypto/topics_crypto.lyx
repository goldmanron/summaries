\begin_layout Section
Conditional Disclosure of Secrets (CDS)
\end_layout

\begin_layout Subsection
Definition and Syntax
\end_layout

\begin_layout Definition

\begin_inset Argument 1
status collapsed


\begin_layout Standard
Conditional Disclosure of Secrets
\end_layout

\end_inset


\begin_inset CommandInset label
LatexCommand label
name "def:cds"

\end_inset

 A CDS protocol for a predicate 
\begin_inset Formula $f:X\times Y\to\{0,1\}$
\end_inset

 and secret space 
\begin_inset Formula $\mathcal{S}$
\end_inset

 consists of a finite randomness space 
\begin_inset Formula $\mathcal{R}$
\end_inset

, message spaces 
\begin_inset Formula $\mathcal{M}_A,\mathcal{M}_B$
\end_inset

, and maps 
\begin_inset Formula \begin{align*}
A&:X\times\mathcal{S}\times\mathcal{R}\to\mathcal{M}_A,\\
B&:Y\times\mathcal{S}\times\mathcal{R}\to\mathcal{M}_B,\\
C&:X\times Y\times\mathcal{M}_A\times\mathcal{M}_B
\to\mathcal{S}\cup\{\bot\}.
\end{align*}
\end_inset

For 
\begin_inset Formula $R\xleftarrow{R}\mathcal{R}$
\end_inset

, write 
\begin_inset Formula $M_A=A(x,s;R)$
\end_inset

 and 
\begin_inset Formula $M_B=B(y,s;R)$
\end_inset

. The following conditions are required. 
\end_layout

\begin_deeper
\begin_layout Enumerate

\emph on
Perfect correctness:
\emph default
 for every 
\begin_inset Formula $(x,y)$
\end_inset

 with 
\begin_inset Formula $f(x,y)=1$
\end_inset

 and every 
\begin_inset Formula $s\in\mathcal{S}$
\end_inset

, 
\begin_inset Formula \begin{equation*}
\Pr[C(x,y,M_A,M_B)=s]=1.
\end{equation*}
\end_inset


\end_layout

\begin_layout Enumerate

\emph on
Perfect privacy:
\emph default
 for every 
\begin_inset Formula $(x,y)$
\end_inset

 with 
\begin_inset Formula $f(x,y)=0$
\end_inset

 and every 
\begin_inset Formula $s_0,s_1\in\mathcal{S}$
\end_inset

, 
\begin_inset Formula \begin{equation*}
(A(x,s_0;R),B(y,s_0;R))
\equiv
(A(x,s_1;R),B(y,s_1;R)).
\end{equation*}
\end_inset


\end_layout

\end_deeper
\begin_layout Definition
The communication complexity is the maximum of 
\begin_inset Formula $|M_A|+|M_B|$
\end_inset

 over all inputs, secrets, and randomness values. The randomness complexity is 
\begin_inset Formula $\lceil\log_2|\mathcal{R}|\rceil$
\end_inset

. 
\end_layout

