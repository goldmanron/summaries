\begin_layout Subsubsection
Polynomial Interpolation
\end_layout

\begin_layout Standard
Let 
\begin_inset Formula $(x_1,y_1),\ldots,(x_t,y_t)$
\end_inset

 be pairs over a field with distinct 
\begin_inset Formula $x_1,\ldots,x_t$
\end_inset

. There is a unique polynomial 
\begin_inset Formula $g$
\end_inset

 of degree at most 
\begin_inset Formula $t-1$
\end_inset

 satisfying 
\begin_inset Formula $g(x_i)=y_i$
\end_inset

 for every 
\begin_inset Formula $i$
\end_inset

.
\end_layout

\begin_layout Standard
Let 
\begin_inset Formula \begin{equation*}
f_1[x]
=y_1\cdot\frac{x-x_2}{x_1-x_2}\cdot
\frac{x-x_3}{x_1-x_3}\cdots
\frac{x-x_t}{x_1-x_t}.
\end{equation*}
\end_inset

The polynomial 
\begin_inset Formula $f_1[x]$
\end_inset

 has degree 
\begin_inset Formula $t-1$
\end_inset

, satisfies 
\begin_inset Formula $f_1(x_1)=y_1$
\end_inset

, and satisfies 
\begin_inset Formula $f_1(x_i)=0$
\end_inset

 for every 
\begin_inset Formula $i\neq1$
\end_inset

.
\end_layout

\begin_layout Definition

\begin_inset Argument 1
status collapsed


\begin_layout Standard
Lagrange interpolation polynomials
\end_layout

\end_inset

For every 
\begin_inset Formula $i\in\{1,\ldots,t\}$
\end_inset

, define 
\begin_inset Formula \begin{equation*}
f_i[x]
=y_i\prod_{\substack{j=1\\j\neq i}}^t
\frac{x-x_j}{x_i-x_j}.
\end{equation*}
\end_inset

Then 
\begin_inset Formula \begin{equation*}
f[x]=f_1[x]+f_2[x]+\cdots+f_t[x]
=\sum_{i=1}^t y_i
\prod_{\substack{j=1\\j\neq i}}^t
\frac{x-x_j}{x_i-x_j}.
\end{equation*}
\end_inset


\end_layout

\begin_layout Standard
The polynomial 
\begin_inset Formula $f$
\end_inset

 has degree at most 
\begin_inset Formula $t-1$
\end_inset

 and is consistent with all 
\begin_inset Formula $t$
\end_inset

 pairs. If 
\begin_inset Formula $g$
\end_inset

 is another such polynomial, then 
\begin_inset Formula $f-g$
\end_inset

 has degree at most 
\begin_inset Formula $t-1$
\end_inset

 and has the 
\begin_inset Formula $t$
\end_inset

 distinct roots 
\begin_inset Formula $x_1,\ldots,x_t$
\end_inset

. The root bound implies 
\begin_inset Formula $f-g=0$
\end_inset

, proving uniqueness.
\end_layout

\begin_layout Standard
For a coalition 
\begin_inset Formula $T$
\end_inset

 whose shares are 
\begin_inset Formula $(i,f(i))_{i\in T}$
\end_inset

, the reconstruction function recovers 
\begin_inset Formula \begin{equation*}
\mathcal{D}_T\bigl((f(i))_{i\in T}\bigr)
=f(0)
=\sum_{i\in T}f(i)
\prod_{\substack{j\in T\\j\neq i}}
\frac{0-j}{i-j}
=s.
\end{equation*}
\end_inset


\end_layout

