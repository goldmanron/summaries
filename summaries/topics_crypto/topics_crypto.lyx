\end_layout

\end_inset

\end_layout

\begin_layout Subsubsection
Statistical Secrecy
\end_layout

\begin_layout Definition

\begin_inset Argument 1
status collapsed


\begin_layout Standard
Statistical distance
\end_layout

\end_inset


\begin_inset CommandInset label
LatexCommand label
name "def:statistical-distance"

\end_inset

 For random variables 
\begin_inset Formula $U,V$
\end_inset

 over a common finite domain, their statistical distance is 
\begin_inset Formula \begin{equation*}
\Delta(U,V)=\max_S\left|\Pr[U\in S]-\Pr[V\in S]\right|.
\end{equation*}
\end_inset

Equivalently, 
\begin_inset Formula \begin{equation*}
\Delta(U,V)=\max_A\left|\Pr[A(U)=1]-\Pr[A(V)=1]\right|,
\end{equation*}
\end_inset

where 
\begin_inset Formula $A$
\end_inset

 ranges over all computationally unbounded distinguishers. 
\end_layout

\begin_layout Standard

\begin_inset Separator plain

\end_inset


\end_layout

\begin_layout Definition

\begin_inset Argument 1
status collapsed


\begin_layout Standard
Statistical secrecy
\end_layout

\end_inset


\begin_inset CommandInset label
LatexCommand label
name "def:statistical-secrecy"

\end_inset

 For every 
\begin_inset Formula $X,Y\in\{0,1\}^n$
\end_inset

, 
\begin_inset Formula \begin{equation*}
\Delta(E_K(X),E_K(Y))\leq\delta,
\qquad K\xleftarrow{R}\mathcal{K}.
\end{equation*}
\end_inset

That is, for every set of ciphertexts 
\begin_inset Formula $S$
\end_inset

, 
\begin_inset Formula \begin{equation*}
\left|\Pr_K[E_K(X)\in S]-\Pr_K[E_K(Y)\in S]\right|\leq\delta,
\end{equation*}
\end_inset

or, equivalently, for every unbounded 
\begin_inset Formula $A$
\end_inset

, 
\begin_inset Formula \begin{equation*}
\left|\Pr_K[A(E_K(X))=1]-\Pr_K[A(E_K(Y))=1]\right|\leq\delta.
\end{equation*}
\end_inset


\end_layout

