\begin_layout Subsection

\begin_inset Formula $3$
\end_inset

CNF Formulas and Cook–Levin
\end_layout

\begin_layout Standard
Let 
\begin_inset Formula $x_1,\ldots,x_n$
\end_inset

 be Boolean variables. For every 
\begin_inset Formula $i$
\end_inset

, the expressions 
\begin_inset Formula $x_i$
\end_inset

 and 
\begin_inset Formula $\overline{x_i}$
\end_inset

 are literals. An or-clause is a disjunction of literals, for example 
\begin_inset Formula \begin{equation*}
x_1\vee\overline{x_5}\vee x_9\vee\overline{x_{17}}.
\end{equation*}
\end_inset

A conjunctive-normal-form formula is a conjunction of or-clauses. It is a 
\begin_inset Formula $3$
\end_inset

CNF formula if every or-clause contains exactly three literals.
\end_layout

\begin_layout Theorem

\begin_inset Argument 1
status collapsed


\begin_layout Standard
Cook–Levin
\end_layout

\end_inset

Fix 
\begin_inset Formula $L\in\mathsf{NP}$
\end_inset

 and let 
\begin_inset Formula $M$
\end_inset

 be its verifier running in time 
\begin_inset Formula $T=\operatorname{poly}(n)$
\end_inset

. There is a 
\begin_inset Formula $3$
\end_inset

CNF formula 
\begin_inset Formula \begin{equation*}
\phi_M(y_1,\ldots,y_N),
\qquad N=\operatorname{poly}(T),
\end{equation*}
\end_inset

such that for every 
\begin_inset Formula $x\in\{0,1\}^n$
\end_inset

, the following are equivalent: 
\end_layout

\begin_deeper
\begin_layout Itemize

\begin_inset Formula $x\in L$
\end_inset

; 
\end_layout

\begin_layout Itemize
there exists 
\begin_inset Formula $w$
\end_inset

 such that 
\begin_inset Formula $M(x,w)=1$
\end_inset

; 
\end_layout

\begin_layout Itemize
there exists an assignment 
\begin_inset Formula $\sigma:[N]\to\{0,1\}$
\end_inset

 such that 
\begin_inset Formula \begin{equation*}
x=(\sigma(1),\ldots,\sigma(n))
\end{equation*}
\end_inset

and 
\begin_inset Formula \begin{equation*}
\phi_M(\sigma(1),\ldots,\sigma(N))=1.
\end{equation*}
\end_inset


\end_layout

\end_deeper
\begin_layout Standard
Let 
\begin_inset Formula $\phi_x$
\end_inset

 be a 
\begin_inset Formula $3$
\end_inset

CNF formula satisfying 
\begin_inset Formula \begin{equation*}
\phi_x(y_1,\ldots,y_N)=1
\quad\Longleftrightarrow\quad
x=(y_1,\ldots,y_n).
\end{equation*}
\end_inset

Then 
\begin_inset Formula \begin{equation*}
x\in L
\quad\Longleftrightarrow\quad
\phi_{M,x}=\phi_M\wedge\phi_x
\text{ is satisfiable}.
\end{equation*}
\end_inset


\end_layout

\begin_layout Subsection
A Succinct Representation of 
\begin_inset Formula $\phi_M$
\end_inset


\end_layout

\begin_layout Standard
For the PCP verifier to run quickly, it needs a succinct representation of 
\begin_inset Formula $\phi_M$
\end_inset

. Let 
\begin_inset Formula \begin{equation*}
\varphi_M:[N]^3\times\{0,1\}^3\longrightarrow\{0,1\}
\end{equation*}
\end_inset

satisfy 
\begin_inset Formula \begin{multline*}
\varphi_M(i_1,i_2,i_3,b_1,b_2,b_3)=1\\
\Longleftrightarrow\quad
\phi_M\text{ contains the clause }
(y_{i_1}=b_1)\vee(y_{i_2}=b_2)\vee(y_{i_3}=b_3).
\end{multline*}
\end_inset

By the Cook–Levin proof, 
\begin_inset Formula $\varphi_M$
\end_inset

 is computed by a Boolean circuit of size 
\begin_inset Formula $\operatorname{polylog}(N)$
\end_inset

 and depth 
\begin_inset Formula $O(\log\log N)$
\end_inset

.
\end_layout

\begin_layout Standard
Similarly, let 
\begin_inset Formula \begin{equation*}
\varphi_x:[N]^3\times\{0,1\}^3\longrightarrow\{0,1\}
\end{equation*}
\end_inset

describe 
\begin_inset Formula $\phi_x$
\end_inset

. Then 
\begin_inset Formula \begin{equation*}
\varphi_{M,x}=\varphi_M+\varphi_x
\end{equation*}
\end_inset

describes 
\begin_inset Formula \begin{equation*}
\phi_{M,x}=\phi_M\wedge\phi_x.
\end{equation*}
\end_inset


\end_layout

