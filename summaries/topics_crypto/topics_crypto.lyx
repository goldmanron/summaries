\end{equation*}
\end_inset


\end_layout

\begin_layout Claim

\begin_inset Argument 1
status collapsed


\begin_layout Standard
Low-degree extension
\end_layout

\end_inset

Fix a field 
\begin_inset Formula $\mathbb{F}$
\end_inset

, a set 
\begin_inset Formula $H\subseteq\mathbb{F}$
\end_inset

, and a function 
\begin_inset Formula \begin{equation*}
\sigma:H^m\longrightarrow\mathbb{F}.
\end{equation*}
\end_inset

There exists a unique polynomial 
\begin_inset Formula \begin{equation*}
\widetilde\sigma:\mathbb{F}^m\longrightarrow\mathbb{F}
\end{equation*}
\end_inset

of individual degree 
\begin_inset Formula $|H|-1$
\end_inset

 satisfying 
\begin_inset Formula \begin{equation*}
\forall x\in H^m:\quad\sigma(x)=\widetilde\sigma(x).
\end{equation*}
\end_inset


\end_layout

\begin_layout Proof
For 
\begin_inset Formula $a\in H$
\end_inset

, define the degree-
\begin_inset Formula $|H|-1$
\end_inset

 Lagrange polynomial 
\begin_inset Formula \begin{equation*}
L_a(x)=\prod_{b\in H\setminus\{a\}}\frac{x-b}{a-b}.
\end{equation*}
\end_inset

Then 
\begin_inset Formula $L_a(a)=1$
\end_inset

 and 
\begin_inset Formula $L_a(b)=0$
\end_inset

 for every 
\begin_inset Formula $b\in H\setminus\{a\}$
\end_inset

. Define 
\begin_inset Formula \begin{equation*}
\widetilde\sigma(x_1,\ldots,x_m)
=\sum_{a_1,\ldots,a_m\in H}
\sigma(a_1,\ldots,a_m)
\prod_{i=1}^{m}L_{a_i}(x_i).
\end{equation*}
\end_inset

This polynomial agrees with 
\begin_inset Formula $\sigma$
\end_inset

 on 
\begin_inset Formula $H^m$
\end_inset

. Uniqueness follows by a counting argument. 
\end_layout

