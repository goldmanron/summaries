\end_inset


\end_layout

\begin_layout Proof
For perfect security, fix a secret 
\begin_inset Formula $s$
\end_inset

 and a coalition 
\begin_inset Formula $T\in\binom{[n]}{n-1}$
\end_inset

.
\end_layout

\begin_layout Proof
If 
\begin_inset Formula $n\notin T$
\end_inset

, then 
\begin_inset Formula $T=\{1,\ldots,n-1\}$
\end_inset

 and 
\begin_inset Formula \begin{equation*}
(s_i)_{i\in T}=(r_1,\ldots,r_{n-1})
\end{equation*}
\end_inset

is uniform over 
\begin_inset Formula $\mathcal{S}^{n-1}$
\end_inset

.
\end_layout

\begin_layout Proof
Otherwise, there is a unique 
\begin_inset Formula $j\in\{1,\ldots,n-1\}$
\end_inset

 such that 
\begin_inset Formula $j\notin T$
\end_inset

. Fix arbitrary target values 
\begin_inset Formula $(a_i)_{i\in T}\in\mathcal{S}^{n-1}$
\end_inset

. For all 
\begin_inset Formula $i\in T\setminus\{n\}$
\end_inset

, the equality 
\begin_inset Formula $s_i=a_i$
\end_inset

