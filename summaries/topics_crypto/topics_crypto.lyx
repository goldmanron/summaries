\begin_layout Subsection
The 
\begin_inset Formula $(4,1)$
\end_inset

-CNF Secret-Sharing Scheme
\end_layout

\begin_layout Standard
Let the parties be 
\begin_inset Formula $P_1,P_2,P_3,P_4$
\end_inset

, and suppose at most one party is corrupted. All values lie in a finite field 
\begin_inset Formula $\mathbb{F}$
\end_inset

.
\end_layout

\begin_layout Definition

\begin_inset Argument 1
status collapsed


\begin_layout Standard

\begin_inset Formula $(4,1)$
\end_inset

-CNF sharing
\end_layout

\end_inset


\begin_inset CommandInset label
LatexCommand label
name "def:cnf-sharing"

\end_inset

 To share 
\begin_inset Formula $s\in\mathbb{F}$
\end_inset

, choose field elements 
\begin_inset Formula \begin{equation*}
r_{1,2,3},\quad r_{1,2,4},\quad r_{1,3,4},\quad r_{2,3,4}
\end{equation*}
\end_inset

subject to 
\begin_inset Formula \begin{equation*}
s=r_{1,2,3}+r_{1,3,4}+r_{2,3,4}+r_{1,2,4}.
\end{equation*}
\end_inset

The value 
\begin_inset Formula $r_{i,j,k}$
\end_inset

 is given to exactly the three parties 
\begin_inset Formula $P_i,P_j,P_k$
\end_inset

. Thus each additive component has three copies. 
\end_layout

\begin_layout Standard
Explicitly, the four local shares are 
\begin_inset Formula \begin{align*}
P_1 &: (r_{1,2,3},r_{1,2,4},r_{1,3,4}),\\
P_2 &: (r_{1,2,3},r_{1,2,4},r_{2,3,4}),\\
P_3 &: (r_{1,2,3},r_{1,3,4},r_{2,3,4}),\\
P_4 &: (r_{1,2,4},r_{1,3,4},r_{2,3,4}).
\end{align*}
\end_inset


\end_layout

\begin_layout Claim

\begin_inset Argument 1
status collapsed


\begin_layout Standard
Privacy
\end_layout

\end_inset

Every single party has a view that is independent of 
\begin_inset Formula $s$
\end_inset

. 
\end_layout

\begin_layout Proof
Each party is missing exactly one of the four additive components. That missing component is uniform subject to the sum constraint and therefore acts as a one-time pad for 
\begin_inset Formula $s$
\end_inset

. 
\end_layout

