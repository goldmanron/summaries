\begin_layout Subsection
Encoding a Function Family
\end_layout

\begin_layout Definition

\begin_inset Argument 1
status collapsed


\begin_layout Standard
Decomposable affine randomized encoding
\end_layout

\end_inset


\begin_inset CommandInset label
LatexCommand label
name "def:dare"

\end_inset

 A DARE for a circuit family 
\begin_inset Formula $\mathcal{C}$
\end_inset

 consists of randomized algorithms 
\begin_inset Formula $\operatorname{Off},\operatorname{On}_1,\ldots,\operatorname{On}_n$
\end_inset

, a decoder 
\begin_inset Formula $\operatorname{Dec}$
\end_inset

, and a simulator 
\begin_inset Formula $\operatorname{Sim}$
\end_inset

. On randomness 
\begin_inset Formula $R$
\end_inset

, the encoding of 
\begin_inset Formula $(C,X)$
\end_inset

 is 
\begin_inset Formula \begin{equation*}
\left(\operatorname{Off}(C;R),
\operatorname{On}_1(C,X_1;R),\ldots,
\operatorname{On}_n(C,X_n;R)\right).
\end{equation*}
\end_inset

Each online component has the form 
\begin_inset Formula \begin{equation*}
\operatorname{On}_i(C,X_i;R)=X_i a_i(C,R)+b_i(C,R).
\end{equation*}
\end_inset

Correctness requires the decoder to output 
\begin_inset Formula $C(X)$
\end_inset

. Privacy requires the encoding distribution to be simulatable from 
\begin_inset Formula $(C,C(X))$
\end_inset

 alone. 
\end_layout

\begin_layout Subsection
Perfect DARE for Formulas
\end_layout

\begin_layout Subsubsection
DARE for Simple Functions
\end_layout

\begin_layout Standard
Addition is encoded by 
\begin_inset Formula \begin{equation*}
x_1+r\mid x_2-r,
\qquad r\xleftarrow{R}\mathbb{F}.
\end{equation*}
\end_inset


\end_layout

\begin_layout Standard
Multiplication is encoded by 
\begin_inset Formula \begin{equation*}
x_1+r_1
\mid x_2+r_2
\mid r_2x_1+r_1r_2+r_3
\mid r_1x_2-r_3.
\end{equation*}
\end_inset

Indeed, subtracting the last two components from the product of the first two recovers 
\begin_inset Formula $x_1x_2$
\end_inset

.
\end_layout

\begin_layout Standard
The function 
\begin_inset Formula $x_1x_2+x_3$
\end_inset

 is handled by an affinization gadget that replaces non-affine intermediate expressions by additional affine input components and an offline part.
\end_layout

\begin_layout Subsubsection
Encoding the Circuit Layer by Layer
\end_layout

\begin_layout Standard
Write a layered circuit as 
\begin_inset Formula \begin{equation*}
C=C_d\circ\cdots\circ C_1.
\end{equation*}
\end_inset

Start with the identity encoding of the output layer. Suppose there is a DARE for 
\begin_inset Formula $C_1\circ\cdots\circ C_{i-1}$
\end_inset

. Substitute the outputs of layer 
\begin_inset Formula $C_i$
\end_inset

 into this encoding and apply the affinization gadget to obtain affine encodings of the new layer inputs. Repeating this process encodes the full circuit.
\end_layout

\begin_layout Standard
The resulting key length is exponential in circuit depth, the output degree is at most three, and the construction applies to logarithmic-depth arithmetic circuits over finite fields.
\end_layout

\begin_layout Theorem

\begin_inset Argument 1
status collapsed


\begin_layout Standard
Perfect DARE for formulas
\end_layout

\end_inset

Every formula, equivalently every logarithmic-depth circuit after formula expansion, has a perfect decomposable affine randomized encoding. The keys may be long. 
\end_layout

\begin_layout Subsection
Computational DARE for General Circuits
\end_layout

\begin_layout Standard
For a general circuit, perform substitution and affinization at every layer, then apply key shrinking so that affine keys do not grow with depth.
\end_layout

\begin_layout Subsubsection
Key-Shrinking Gadget
\end_layout

\begin_layout Standard
The gadget encodes a long affine function 
\begin_inset Formula \begin{equation*}
y c+d
\end{equation*}
\end_inset

by a short affine function 
\begin_inset Formula \begin{equation*}
y a+b
\end{equation*}
\end_inset

together with an offline string 
\begin_inset Formula $W$
\end_inset

. The values 
\begin_inset Formula $a,b,W$
\end_inset

 may depend on 
\begin_inset Formula $c,d$
\end_inset

 and the randomness. A decoder recovers the original affine value, and a simulator generates the encoding from that value alone.
\end_layout

\begin_layout Standard
In the Boolean case, if 
\begin_inset Formula $y=0$
\end_inset

 the encoding should release 
\begin_inset Formula $d$
\end_inset

, while if 
\begin_inset Formula $y=1$
\end_inset

 it should release 
\begin_inset Formula $c+d$
\end_inset

. The offline information contains encryptions 
\begin_inset Formula \begin{equation*}
E_b(d)
\qquad\text{and}\qquad
E_{a+b}(c+d).
\end{equation*}
\end_inset


\end_layout

\begin_layout Theorem

\begin_inset Argument 1
status collapsed


\begin_layout Standard
DARE for Boolean circuits from one-way functions
\end_layout

\end_inset

Assuming one-way functions, every Boolean circuit has a computationally private DARE. The online complexity is 
\begin_inset Formula $n\lambda$
\end_inset

, independent of 
\begin_inset Formula $|C|$
\end_inset

. 
\end_layout

