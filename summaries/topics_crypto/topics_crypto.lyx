\end_layout

\begin_layout Subsubsection
Keyword Search
\end_layout

\begin_layout Standard
Let 
\begin_inset Formula $X=\{x_1,\ldots,x_N\}\subseteq\{0,1\}^n$
\end_inset

 and let 
\begin_inset Formula $x$
\end_inset

 be a query keyword. Generate DPF keys 
\begin_inset Formula $(K_0,K_1)$
\end_inset

 for 
\begin_inset Formula $f_{x,1}$
\end_inset

 over 
\begin_inset Formula $\mathbb{Z}_2$
\end_inset

. Server 
\begin_inset Formula $p$
\end_inset

 returns 
\begin_inset Formula \begin{equation*}
y_p=\bigoplus_{i=1}^N\operatorname{Eval}(p,K_p,x_i).
\end{equation*}
\end_inset

Correctness of the DPF gives 
\begin_inset Formula \begin{equation*}
y_0\oplus y_1
=\bigoplus_{i=1}^N f_{x,1}(x_i)
=\mathbf{1}_{\{x\in X\}},
\end{equation*}
\end_inset

where the last equality uses that 
\begin_inset Formula $X$
\end_inset

 is a set.
\end_layout

\begin_layout Standard
For records 
\begin_inset Formula $(x_i,p_i)$
\end_inset

 with payloads in an abelian group, define 
\begin_inset Formula \begin{equation*}
y_p=\sum_{i=1}^N p_i\operatorname{Eval}(p,K_p,x_i).
\end{equation*}
\end_inset

Then 
\begin_inset Formula $y_0+y_1$
\end_inset

 equals the sum of the payloads whose keyword is 
\begin_inset Formula $x$
\end_inset

.
\end_layout

\begin_layout Standard
More generally, let 
\begin_inset Formula $(K_0,K_1)$
\end_inset

 be FSS keys for 
\begin_inset Formula $f:\{0,1\}^n\to\mathbb{Z}_u$
\end_inset

 and define 
\begin_inset Formula \begin{equation*}
y_p=\sum_{i=1}^N\operatorname{Eval}(p,K_p,x_i).
\end{equation*}
\end_inset

The reconstruction identity is 
\begin_inset Formula \begin{equation*}
y_0+y_1=\sum_{i=1}^N f(x_i).
\end{equation*}
\end_inset


\end_layout

\begin_layout Subsubsection
Secure Aggregation
\end_layout

\begin_layout Standard
For an update to location 
\begin_inset Formula $\alpha\in\{0,1\}^n$
\end_inset

, generate DPF keys 
\begin_inset Formula $(K_0,K_1)$
\end_inset

 for 
\begin_inset Formula $f_{\alpha,1}:\{0,1\}^n\to\mathbb{Z}_u$
\end_inset

. Server 
\begin_inset Formula $p$
\end_inset

 updates each aggregate coordinate 
\begin_inset Formula $z$
\end_inset

 by 
\begin_inset Formula \begin{equation*}
X_p[z]\longleftarrow
X_p[z]+\operatorname{Eval}(p,K_p,z).
\end{equation*}
\end_inset

After reconstruction, the aggregate changes by one at 
\begin_inset Formula $z=\alpha$
\end_inset

 and is unchanged at every 
\begin_inset Formula $z\neq\alpha$
\end_inset

.
\end_layout

