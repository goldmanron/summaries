\end_layout

\end_inset

For every 
\begin_inset Formula $f:\{0,1\}^n\times\{0,1\}^n\to\{0,1\}$
\end_inset

, 
\begin_inset Formula \begin{equation*}
\overline{\operatorname{CDS}}(f)\leq3.
\end{equation*}
\end_inset


\end_layout

\begin_layout Definition

\begin_inset Argument 1
status collapsed


\begin_layout Standard
