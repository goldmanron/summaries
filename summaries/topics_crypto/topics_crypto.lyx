\begin_layout Subsubsection
Perfect Indistinguishability and the Turing Game
\end_layout

\begin_layout Definition

\begin_inset Argument 1
status collapsed


\begin_layout Standard
Perfect indistinguishability
\end_layout

\end_inset

The encryption scheme 
\begin_inset Formula $(E,D)$
\end_inset

 is perfectly indistinguishable (or perfectly secure) if for every 
\begin_inset Formula $m\neq m'\in\mathcal{M}$
\end_inset

 and every 
\begin_inset Formula $c\in\mathcal{C}$
\end_inset

, 
\begin_inset Formula \begin{equation*}
\Pr_{K\xleftarrow{R}\mathcal{K}}[E_K(m)=c]
=\Pr_{K\xleftarrow{R}\mathcal{K}}[E_K(m')=c].
\end{equation*}
\end_inset


\end_layout

