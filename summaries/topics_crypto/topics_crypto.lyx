\begin_layout Standard
Let 
\begin_inset Formula \begin{equation*}
f:\{0,1\}^n\times\{0,1\}^n\longrightarrow\{0,1\},
\qquad N=2^n.
\end{equation*}
\end_inset


\begin_inset ERT
status collapsed

\begin_layout Plain Layout

\backslash
begin{protocol}
\end_layout

\end_inset


\begin_inset ERT
status collapsed

\begin_layout Plain Layout
[
\end_layout

\end_inset

Universal PSM
\begin_inset ERT
status collapsed

\begin_layout Plain Layout
]
\end_layout

\end_inset

 Choose a uniform mask 
\begin_inset Formula $r\in\{0,1\}^N$
\end_inset

 and a uniform cyclic shift 
\begin_inset Formula $s\in[N]$
\end_inset

. The first sender transmits 
\begin_inset Formula \begin{equation*}
M_A=(f(x_A,\cdot)\oplus r)\ll s.
\end{equation*}
\end_inset

The second sender transmits 
\begin_inset Formula \begin{equation*}
x'_B=x_B+s
\qquad\text{and}\qquad
r[x'_B].
\end{equation*}
\end_inset


\begin_inset ERT
status collapsed

\begin_layout Plain Layout

\backslash
end{protocol}
\end_layout

\end_inset


\end_layout

\begin_layout Theorem

\begin_inset Argument 1
status collapsed


\begin_layout Standard
FKN universal PSM
\end_layout

\end_inset

The construction is a PSM for every 
\begin_inset Formula $f$
\end_inset

 with communication 
\begin_inset Formula \begin{equation*}
N+\log N+1=2^n+n+1.
\end{equation*}
\end_inset


\end_layout

\begin_layout Proof
The decoder reads the coordinate 
\begin_inset Formula $x'_B$
\end_inset

 of Alice's shifted row and XORs it with Bob's mask bit. The result is 
\begin_inset Formula $f(x_A,x_B)$
\end_inset

.
\end_layout

\begin_layout Proof
For privacy, given only 
\begin_inset Formula $w=f(x_A,x_B)$
\end_inset

, the simulator samples 
\begin_inset Formula $x'_B$
\end_inset

 uniformly, samples the 
\begin_inset Formula $N$
\end_inset

-bit string 
\begin_inset Formula $M_A$
\end_inset

 uniformly subject to one constraint, and sets the final bit so that 
\begin_inset Formula \begin{equation*}
M_A[x'_B]\oplus r[x'_B]=w.
\end{equation*}
\end_inset

The real transcript has exactly this distribution: the shift makes 
\begin_inset Formula $x'_B$
\end_inset

 uniform and the one-time pad makes every other coordinate uniform. 
\end_layout

\begin_layout Subsubsection
Three-Party PSM from a Three-Dimensional Truth Table
\end_layout

\begin_layout Theorem

\begin_inset Argument 1
status collapsed


\begin_layout Standard
HW 3, Exercise 4
\end_layout

\end_inset

Every function 
\begin_inset Formula \begin{equation*}
f:\{0,1\}^{n/3}\times\{0,1\}^{n/3}\times\{0,1\}^{n/3}
\longrightarrow\{0,1\}
\end{equation*}
\end_inset

has a three-party PSM with communication 
\begin_inset Formula \begin{equation*}
O(2^{2n/3})<2^{0.9n}.
\end{equation*}
\end_inset


\end_layout

\begin_layout Proof
Let 
\begin_inset Formula $x,y,z\in\{0,1\}^{n/3}$
\end_inset

 and 
\begin_inset Formula $N=2^{n/3}$
\end_inset

. For every fixed 
\begin_inset Formula $x$
\end_inset

, define the 
\begin_inset Formula $N\times N$
\end_inset

 truth table 
\begin_inset Formula \begin{equation*}
T_x[i,j]=f(x,i,j).
\end{equation*}
\end_inset

The shared randomness is 
\begin_inset Formula \begin{equation*}
R\xleftarrow{R}\{0,1\}^{N\times N},
\qquad
q\xleftarrow{R}\{0,1\}^N,
\qquad
s,t\xleftarrow{R}[N].
\end{equation*}
\end_inset


\end_layout

\begin_layout Proof
Party 
\begin_inset Formula $P_1$
\end_inset

 sends 
\begin_inset Formula \begin{equation*}
M_1=T_x\oplus R\ll s,t,
\end{equation*}
\end_inset

meaning that the masked table is shifted by 
\begin_inset Formula $s$
\end_inset

 in the 
\begin_inset Formula $y$
\end_inset

 coordinate and by 
\begin_inset Formula $t$
\end_inset

 in the 
\begin_inset Formula $z$
\end_inset

 coordinate. Party 
\begin_inset Formula $P_2$
\end_inset

 sends 
\begin_inset Formula \begin{equation*}
y'=y+s
\qquad\text{and}\qquad
M_2=R_{y,\cdot}\oplus q\ll t.
\end{equation*}
\end_inset

Party 
\begin_inset Formula $P_3$
\end_inset

 sends 
\begin_inset Formula \begin{equation*}
z'=z+t
\qquad\text{and}\qquad
M_3=q[z'].
\end{equation*}
\end_inset

The referee outputs 
\begin_inset Formula \begin{equation*}
M_1[y',z']\oplus M_2[z']\oplus M_3.
\end{equation*}
\end_inset


\end_layout

\begin_layout Proof
For correctness, since 
\begin_inset Formula $y'=y+s$
\end_inset

 and 
\begin_inset Formula $z'=z+t$
\end_inset

, 
\begin_inset Formula \begin{align*}
M_1[y',z']&=f(x,y,z)\oplus R[y,z],\\
M_2[z']&=R[y,z]\oplus q[z],\\
M_3&=q[z].
\end{align*}
\end_inset

Their XOR is 
\begin_inset Formula $f(x,y,z)$
\end_inset

.
\end_layout

\begin_layout Proof
For privacy, let 
\begin_inset Formula $w=f(x,y,z)$
\end_inset

. The simulator samples uniformly 
\begin_inset Formula \begin{equation*}
y',z'\in[N],
\qquad M_2\in\{0,1\}^N,
\qquad M_3\in\{0,1\},
\end{equation*}
\end_inset

and samples 
\begin_inset Formula $M_1\in\{0,1\}^{N\times N}$
\end_inset

 uniformly except for the single coordinate 
\begin_inset Formula \begin{equation*}
M_1[y',z']=w\oplus M_2[z']\oplus M_3.
\end{equation*}
\end_inset

The masks 
\begin_inset Formula $R,q$
\end_inset

 and shifts 
\begin_inset Formula $s,t$
\end_inset

 make the real view uniform subject to this same equation. Hence 
\begin_inset Formula \begin{equation*}
\operatorname{Sim}(f(x,y,z))
\equiv(M_1,y',M_2,z',M_3).
\end{equation*}
\end_inset


\end_layout

\begin_layout Proof
The messages have lengths 
\begin_inset Formula $N^2$
\end_inset

, 
\begin_inset Formula $N+\log N$
\end_inset

, and 
\begin_inset Formula $\log N+1$
\end_inset

, respectively. Thus 
\begin_inset Formula \begin{equation*}
\operatorname{comm}
=2^{2n/3}+2^{n/3}+O(n)
=O(2^{2n/3})<2^{0.9n}.
\end{equation*}
\end_inset


\end_layout

