\begin_layout Subsection
Classical Proof Systems
\end_layout

\begin_layout Definition

\begin_inset Argument 1
status collapsed


\begin_layout Standard
Proof system for a language
\end_layout

\end_inset

Let 
\begin_inset Formula $L\subseteq\{0,1\}^*$
\end_inset

. A deterministic verifier 
\begin_inset Formula $V:\{0,1\}^*\times\{0,1\}^*\to\{0,1\}$
\end_inset

 is a proof system for 
\begin_inset Formula $L$
\end_inset

 if 
\begin_inset Formula \begin{align*}
\emph{Completeness: }&
\forall x\in L,\ \exists\pi:\ V(x,\pi)=1,\\
\emph{Soundness: }&
\forall x\notin L,\ \forall\pi:\ V(x,\pi)=0.
\end{align*}
\end_inset


\end_layout

\begin_layout Subsection

\begin_inset Formula $\mathsf{NP}$
\end_inset

 Proofs
\end_layout

\begin_layout Definition

\begin_inset Argument 1
status collapsed


\begin_layout Standard
Polynomial-time verifier and 
\begin_inset Formula $\mathsf{NP}$
\end_inset


\end_layout

\end_inset

A language 
\begin_inset Formula $L$
\end_inset

 belongs to 
\begin_inset Formula $\mathsf{NP}$
\end_inset

 if there exist a deterministic polynomial-time verifier 
\begin_inset Formula $V$
\end_inset

 and a polynomial 
\begin_inset Formula $p$
\end_inset

 such that 
\begin_inset Formula \begin{align*}
x\in L&\Longrightarrow \exists\pi, |\pi|\leq p(|x|):V(x,\pi)=1,\\
x\notin L&\Longrightarrow \forall\pi, |\pi|\leq p(|x|):V(x,\pi)=0.
\end{align*}
\end_inset


\end_layout

\begin_layout Standard
For example, 
\begin_inset Formula \begin{equation*}
\mathsf{CIRSAT}
=\{C:\text{$C$ is a Boolean circuit and }\exists y:\ C(y)=1\}
\in\mathsf{NP}.
\end{equation*}
\end_inset

Moreover, 
\begin_inset Formula $\mathsf{CIRSAT}$
\end_inset

 is 
\begin_inset Formula $\mathsf{NP}$
\end_inset

-complete: for every 
\begin_inset Formula $L\in\mathsf{NP}$
\end_inset

, we can translate in polynomial time any 
\begin_inset Formula $x$
\end_inset

 into a circuit 
\begin_inset Formula $C_x$
\end_inset

 such that 
\begin_inset Formula \begin{equation*}
x\in L\quad\Longleftrightarrow\quad C_x\in\mathsf{CIRSAT}.
\end{equation*}
\end_inset


\end_layout

\begin_layout Standard
Define 
\begin_inset Formula \begin{equation*}
\mathsf{coNP}=\{L:\overline{L}\in\mathsf{NP}\}
\end{equation*}
\end_inset

and 
\begin_inset Formula $\mathsf{EXP}$
\end_inset

, the class of languages decidable in exponential time.
\end_layout

\begin_layout Subsection
Interactive Proofs
\end_layout

\begin_layout Standard
Interactive proofs replace the static proof 
\begin_inset Formula $\pi$
\end_inset

 by an interactive prover 
\begin_inset Formula $P$
\end_inset

 and allow the verifier to use randomness.
\end_layout

\begin_layout Definition

\begin_inset Argument 1
status collapsed


\begin_layout Standard
Interactive proof
\end_layout

\end_inset


\begin_inset CommandInset label
LatexCommand label
name "def:interactive-proof"

\end_inset

 An interactive proof system 
\begin_inset Formula $(P,V)$
\end_inset

 for 
\begin_inset Formula $L$
\end_inset

 satisfies:
\end_layout

\begin_layout Definition

\emph on
Completeness:
\emph default
 for every 
\begin_inset Formula $x\in L$
\end_inset

, 
\begin_inset Formula \begin{equation*}
\Pr_V[\langle P(x)\leftrightarrow V(x)\rangle_V=1]=1.
\end{equation*}
\end_inset


\end_layout

\begin_layout Definition

\emph on
Soundness:
\emph default
 for every cheating prover 
\begin_inset Formula $P^*$
\end_inset

 and every 
\begin_inset Formula $x\notin L$
\end_inset

, 
\begin_inset Formula \begin{equation*}
\Pr_V[\langle P^*(x)\leftrightarrow V(x)\rangle_V=1]<\frac12.
\end{equation*}
\end_inset


\end_layout

\begin_layout Standard
The parameters 
\begin_inset Formula $(1,1/2)$
\end_inset

 can be replaced by 
\begin_inset Formula $(1-\epsilon_s,\epsilon_c)$
\end_inset

 whenever 
\begin_inset Formula \begin{equation*}
1-\epsilon_s>\epsilon_c+\frac{1}{\operatorname{poly}(|x|)}.
\end{equation*}
\end_inset


\end_layout

\begin_layout Subsection
Zero Knowledge
\end_layout

\begin_layout Standard
Let 
\begin_inset Formula $(P,V)$
\end_inset

 be an interactive proof system for 
\begin_inset Formula $L$
\end_inset

. By interacting with 
\begin_inset Formula $P(x)$
\end_inset

, the verifier can learn that 
\begin_inset Formula $x\in L$
\end_inset

. Zero knowledge asks what else the verifier can learn, including when the verifier cheats.
\end_layout

\begin_layout Definition

\begin_inset Argument 1
status collapsed


\begin_layout Standard
Zero knowledge
\end_layout

\end_inset


\begin_inset CommandInset label
LatexCommand label
name "def:zero-knowledge"

\end_inset

