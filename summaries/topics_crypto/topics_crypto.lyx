\begin_layout Standard
[Hamming 47, Shannon 48]
\end_layout

\begin_layout Definition

\begin_inset Argument 1
status collapsed


\begin_layout Standard
Error-correcting encoding
\end_layout

\end_inset

Let 
\begin_inset Formula $\Sigma$
\end_inset

 be an alphabet. An error-correcting encoding is a pair of maps 
\begin_inset Formula \begin{equation*}
\operatorname{Enc}:\Sigma^k\longrightarrow\Sigma^N,
\qquad
\operatorname{Dec}:(\Sigma\cup\{\bot\})^N
\longrightarrow\Sigma^k.
\end{equation*}
\end_inset

For every message 
\begin_inset Formula $M=(M_1,\ldots,M_k)\in\Sigma^k$
\end_inset

, let 
\begin_inset Formula $C=\operatorname{Enc}(M)$
\end_inset

. Correctness against a 
\begin_inset Formula $\delta$
\end_inset

-fraction of corruptions or erasures requires that, for every 
\begin_inset Formula $Y\in(\Sigma\cup\{\bot\})^N$
\end_inset

 satisfying 
\begin_inset Formula \begin{equation*}
\left|\{i\in[N]:Y_i\neq C_i\}\right|\leq\delta N,
\end{equation*}
\end_inset

the decoder recovers 
\begin_inset Formula \begin{equation*}
\operatorname{Dec}(Y)=M.
\end{equation*}
\end_inset


\end_layout

