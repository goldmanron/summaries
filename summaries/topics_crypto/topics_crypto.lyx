\begin_layout Subsection
Inner Product via OT
\end_layout

\begin_layout Theorem

\begin_inset Argument 1
status collapsed


\begin_layout Standard
Inner product from parallel OT
\end_layout

\end_inset

The binary inner product can be computed with perfect privacy using 
\begin_inset Formula $n$
\end_inset

 parallel calls to OT. 
\end_layout

\begin_layout Proof
Alice holds 
\begin_inset Formula $x=(x_1,\ldots,x_n)$
\end_inset

 and Bob holds 
\begin_inset Formula $y=(y_1,\ldots,y_n)$
\end_inset

. They wish to compute 
\begin_inset Formula \begin{equation*}
\langle x,y\rangle
=x_1y_1+\cdots+x_ny_n\pmod2.
\end{equation*}
\end_inset


\end_layout

\begin_layout Proof
Alice samples 
\begin_inset Formula $r_1,\ldots,r_{n-1}$
\end_inset

 and defines 
\begin_inset Formula \begin{equation*}
r_n=-\sum_{i=1}^{n-1}r_i.
\end{equation*}
\end_inset

For every 
\begin_inset Formula $i$
\end_inset

, Alice acts as OT sender with 
\begin_inset Formula \begin{equation*}
(a_{i,0},a_{i,1})=(r_i,x_i+r_i),
\end{equation*}
\end_inset

and Bob selects 
\begin_inset Formula $y_i$
\end_inset

. Bob receives 
\begin_inset Formula \begin{equation*}
a_{i,y_i}=x_i y_i+r_i.
\end{equation*}
\end_inset

Summing all received values cancels the 
\begin_inset Formula $r_i$
\end_inset

 and gives the inner product. Each OT hides 
\begin_inset Formula $y_i$
\end_inset

 from Alice and reveals only 
\begin_inset Formula $a_{i,y_i}$
\end_inset

 to Bob. The received values are uniformly masked subject to their sum, so Bob's view is simulatable from 
\begin_inset Formula $y$
\end_inset

 and 
\begin_inset Formula $\langle x,y\rangle$
\end_inset

. 
\end_layout

