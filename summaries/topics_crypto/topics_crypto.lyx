\begin_layout Section
Secure Two-Party Computation over an OT Channel
\end_layout

\begin_layout Subsection
Two-Party Interactive Protocols
\end_layout

\begin_layout Standard
Let 
\begin_inset Formula $f:X_A\times X_B\to Y$
\end_inset

. The first party holds 
\begin_inset Formula $x_A\in X_A$
\end_inset

 and private randomness 
\begin_inset Formula $R_A$
\end_inset

; the second holds 
\begin_inset Formula $x_B\in X_B$
\end_inset

 and private randomness 
\begin_inset Formula $R_B$
\end_inset

. A 
\begin_inset Formula $t$
\end_inset

-round protocol is specified by message maps of the form 
\begin_inset Formula \begin{align*}
a_1&=A_1(x_A,R_A),\\
b_1&=B_1(x_B,R_B,a_1),\\
&\ \,\vdots\\
a_t&=A_t(x_A,R_A,b_1,\ldots,b_t),
\end{align*}
\end_inset

and Bob outputs 
\begin_inset Formula \begin{equation*}
\operatorname{Dec}(x_B,R_B,a_1,\ldots,a_t).
\end{equation*}
\end_inset


\end_layout

\begin_layout Definition

\begin_inset Argument 1
status collapsed


\begin_layout Standard
Correctness
\end_layout

\end_inset

The protocol is correct if Bob always outputs 
\begin_inset Formula \begin{equation*}
f(x_A,x_B).
\end{equation*}
\end_inset


\end_layout

\begin_layout Standard

\begin_inset Separator plain

\end_inset


\end_layout

\begin_layout Definition

\begin_inset Argument 1
status collapsed


\begin_layout Standard
Bob's view and privacy
\end_layout

\end_inset


\begin_inset CommandInset label
LatexCommand label
name "def:passive-privacy-bob"

\end_inset

 Bob's view is everything Bob sees: 
\begin_inset Formula \begin{equation*}
\operatorname{View}_B(x_A,x_B)
=(x_B,R_B,a_1,\ldots,a_t),
\end{equation*}
\end_inset

a random variable induced by 
\begin_inset Formula $(R_A,R_B)$
\end_inset

. Privacy against Bob requires a simulator 
\begin_inset Formula $S_B$
\end_inset

 such that for every 
\begin_inset Formula $x_A,x_B$
\end_inset

, 
\begin_inset Formula \begin{equation*}
\operatorname{View}_B(x_A,x_B)
\equiv
S_B(x_B,f(x_A,x_B)).
\end{equation*}
\end_inset


\end_layout

\begin_layout Standard

\begin_inset Separator plain

\end_inset


\end_layout

\begin_layout Definition

\begin_inset Argument 1
status collapsed


\begin_layout Standard
Alice's view and privacy
\end_layout

\end_inset


\begin_inset CommandInset label
LatexCommand label
name "def:passive-privacy-alice"

\end_inset

 Privacy against Alice requires a simulator 
\begin_inset Formula $S_A$
\end_inset

 such that for every 
\begin_inset Formula $x_A,x_B$
\end_inset

, 
\begin_inset Formula \begin{equation*}
\operatorname{View}_A(x_A,x_B)
\equiv
S_A(x_A,\bot).
\end{equation*}
\end_inset

Alice should not learn the output. Both privacy definitions can be relaxed to computational indistinguishability. 
\end_layout

\begin_layout Standard
\begin_inset ERT
status collapsed

\begin_layout Plain Layout

\backslash
imageplaceholder{images/chapter-7-interactive-protocol.png}[H]
\end_layout

\begin_layout Plain Layout
{Two-party interactive protocol, correctness, and privacy views}
\end_layout

\end_inset

\end_layout

\begin_layout Subsubsection
Example: XOR
\end_layout

\begin_layout Claim

\begin_inset Argument 1
status collapsed


\begin_layout Standard
Plain-model protocol for XOR
\end_layout

\end_inset

For 
\begin_inset Formula \begin{equation*}
f(x_A,x_B)=x_A\oplus x_B,
\end{equation*}
\end_inset

there is a one-message perfectly private protocol in which only Bob receives the output. 
\end_layout

\begin_layout Proof
Given the output and his own input, Bob knows Alice's input exactly. Alice sends 
\begin_inset Formula \begin{equation*}
a_1=x_A,
\end{equation*}
\end_inset

and Bob outputs 
\begin_inset Formula \begin{equation*}
\operatorname{Dec}(x_B,a_1)=x_B\oplus a_1.
\end{equation*}
\end_inset

Bob's message reveals no more than is already determined by his input and output, and Alice receives no messages. 
\end_layout

\begin_layout Subsection
The Impossibility of AND in the Plain Model
\end_layout

\begin_layout Standard
For 
\begin_inset Formula \begin{equation*}
f(x_A,x_B)=x_A\wedge x_B,
\end{equation*}
\end_inset

Bob should not learn Alice's value when his own input is 
\begin_inset Formula $0$
\end_inset

.
\end_layout

\begin_layout Standard
In one round, correctness for Bob's input 
\begin_inset Formula $1$
\end_inset

 requires the message to distinguish 
\begin_inset Formula $x_A=0$
\end_inset

 from 
\begin_inset Formula $x_A=1$
\end_inset

. Bob can use the same distinction when his actual input is 
\begin_inset Formula $0$
\end_inset

, violating privacy.
\end_layout

\begin_layout Theorem

\begin_inset Argument 1
status collapsed


\begin_layout Standard
HW 4, Exercise 1
\end_layout

\end_inset

It is impossible to privately compute, with passive security in the plain model, the function that takes a bit 
\begin_inset Formula $x_A$
\end_inset

 from Alice and a bit 
\begin_inset Formula $x_B$
\end_inset

 from Bob and delivers 
\begin_inset Formula $x_A\wedge x_B$
\end_inset

 to Bob. 
\end_layout

\begin_layout Proof
Assume toward contradiction that there is a passive secure protocol for 
\begin_inset Formula \begin{equation*}
f(x_A,x_B)=x_A\wedge x_B
\end{equation*}
\end_inset

where only Bob receives the output.
\end_layout

\begin_layout Proof
From privacy against Alice, since Alice gets no output, 
\begin_inset Formula \begin{equation*}
\operatorname{View}_A(x_A,0)
\equiv
\operatorname{View}_A(x_A,1)
\end{equation*}
\end_inset

for every 
\begin_inset Formula $x_A$
\end_inset

.
\end_layout

\begin_layout Proof
From privacy against Bob, if 
\begin_inset Formula $x_B=0$
\end_inset

, then the output is always 
\begin_inset Formula $0$
\end_inset

. Therefore Bob must not learn 
\begin_inset Formula $x_A$
\end_inset

, so 
\begin_inset Formula \begin{equation*}
\operatorname{View}_B(0,0)
\equiv
\operatorname{View}_B(1,0).
\end{equation*}
\end_inset


\end_layout

\begin_layout Proof
We prove by induction on the number of messages that also 
\begin_inset Formula \begin{equation*}
\operatorname{View}_B(0,1)
\equiv
\operatorname{View}_B(1,1).
\end{equation*}
\end_inset


\end_layout

\begin_layout Proof

\emph on
Base case.
\emph default
 For the first Alice message, 
\begin_inset Formula \begin{equation*}
a_1=A_1(x_A,R_A).
\end{equation*}
\end_inset

This message does not depend on 
\begin_inset Formula $x_B$
\end_inset

, because Bob has not sent anything yet. So even if Bob's real input is 
\begin_inset Formula $0$
\end_inset

, he receives the same kind of Alice message as he would receive if his input were 
\begin_inset Formula $1$
\end_inset

. Therefore, if this message lets Bob decode 
\begin_inset Formula $x_A$
\end_inset

 when using 
\begin_inset Formula $x_B=1$
\end_inset

, he can run the same decoding locally even when his real input is 
\begin_inset Formula $0$
\end_inset

.
\end_layout

\begin_layout Proof
The induction uses the following invariant: 
\begin_inset Formula \begin{equation*}
\operatorname{Dec}(1,R_B,a_1)=x_A
\end{equation*}
\end_inset

would allow Bob with real input 
\begin_inset Formula $0$
\end_inset

 to recover 
\begin_inset Formula $x_A$
\end_inset

, which violates privacy.
\end_layout

\begin_layout Proof

\emph on
Induction step.
\emph default
 Assume that up to round 
\begin_inset Formula $i$
\end_inset

, Bob can reproduce the same distribution of Alice's messages in the execution with 
\begin_inset Formula $x_B=1$
\end_inset

 as in the execution with 
\begin_inset Formula $x_B=0$
\end_inset

. Consider Alice's next message: 
\begin_inset Formula \begin{equation*}
a_{i+1}=A_{i+1}(x_A,R_A,b_1,\ldots,b_i).
\end{equation*}
\end_inset

By privacy against Alice, 
\begin_inset Formula \begin{equation*}
\operatorname{View}_A(x_A,0)
\equiv
\operatorname{View}_A(x_A,1).
\end{equation*}
\end_inset

So the messages 
\begin_inset Formula $b_1,\ldots,b_i$
\end_inset

 that Alice sees are distributed the same whether Bob's input is 
\begin_inset Formula $0$
\end_inset

 or 
\begin_inset Formula $1$
\end_inset

. Hence Alice's next message 
\begin_inset Formula $a_{i+1}$
\end_inset

 is also distributed the same in both cases.
\end_layout

\begin_layout Proof
Therefore, Bob with input 
\begin_inset Formula $0$
\end_inset

 can reproduce the same distribution of Alice messages that he would get with input 
\begin_inset Formula $1$
\end_inset

. By induction, this holds for all rounds. Thus, 
\begin_inset Formula \begin{equation*}
\operatorname{View}_B(0,1)
\equiv
\operatorname{View}_B(1,1).
\end{equation*}
\end_inset


\end_layout

\begin_layout Proof
For the contradiction, correctness requires that when 
\begin_inset Formula $x_B=1$
\end_inset

, 
\begin_inset Formula \begin{equation*}
f(0,1)=0
\qquad\text{but}\qquad
f(1,1)=1.
\end{equation*}
\end_inset

So Bob must distinguish the executions 
\begin_inset Formula $(0,1)$
\end_inset

 and 
\begin_inset Formula $(1,1)$
\end_inset

. But we proved 
\begin_inset Formula \begin{equation*}
\operatorname{View}_B(0,1)
\equiv
\operatorname{View}_B(1,1),
\end{equation*}
\end_inset

which is impossible. Therefore AND cannot be securely computed in the plain model with passive security. 
\end_layout

