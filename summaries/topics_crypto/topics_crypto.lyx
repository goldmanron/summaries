\begin_layout Subsection
Flawed Interactive Proofs for 
\begin_inset Formula $\#\mathsf{SAT}$
\end_inset


\end_layout

\begin_layout Standard
Consider the claim 
\begin_inset Formula \begin{equation*}
\sum_{x_1,\ldots,x_n\in\{0,1\}}
\phi(x_1,x_2,\ldots,x_n)=s.
\end{equation*}
\end_inset


\end_layout

\begin_layout Standard
For 
\begin_inset Formula $b\in\{0,1\}$
\end_inset

, the prover sets 
\begin_inset Formula \begin{equation*}
\phi_b^1(x_2,\ldots,x_n)=\phi(b,x_2,\ldots,x_n)
\end{equation*}
\end_inset

and computes 
\begin_inset Formula \begin{equation*}
s_b^1=
\sum_{x_2,\ldots,x_n\in\{0,1\}}
\phi_b^1(x_2,\ldots,x_n).
\end{equation*}
\end_inset

The prover sends 
\begin_inset Formula $s_0^1,s_1^1$
\end_inset

 to the verifier, which checks 
\begin_inset Formula \begin{equation*}
s_0^1+s_1^1=s.
\end{equation*}
\end_inset


\end_layout

\begin_layout Standard
Recursing on both statements 
\begin_inset Formula \begin{equation*}
s_b^1=
\sum_{x\in\{0,1\}^{n-1}}\phi_b^1(x),
\qquad b\in\{0,1\},
\end{equation*}
\end_inset

makes the verifier run in time 
\begin_inset Formula $2^{O(n)}$
\end_inset

.
\end_layout

\begin_layout Standard
In the second flawed protocol, the verifier samples 
\begin_inset Formula \begin{equation*}
b_1\xleftarrow{R}\{0,1\}
\end{equation*}
\end_inset

and recurses only on the statement 
\begin_inset Formula \begin{equation*}
s_{b_1}^1=
